---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { db } from '../../db/index.js';
import { appointments, barbers, services } from '../../db/schema.js';
import { eq } from 'drizzle-orm';
import { formatInTimeZone } from 'date-fns-tz';

const { token } = Astro.params;
if (!token) return Astro.redirect('/agendar');

const TZ = 'America/Fortaleza';
const WHATSAPP = process.env.WHATSAPP_BARBEARIA ?? '';

const rows = db
  .select({
    id:              appointments.id,
    status:          appointments.status,
    startsAt:        appointments.startsAt,
    endsAt:          appointments.endsAt,
    durationMinutes: appointments.durationMinutes,
    priceCents:      appointments.priceCents,
    customerName:    appointments.customerName,
    cancelledAt:     appointments.cancelledAt,
    cancelledBy:     appointments.cancelledBy,
    barberName:      barbers.name,
    serviceName:     services.name,
  })
  .from(appointments)
  .innerJoin(barbers,   eq(barbers.id,   appointments.barberId))
  .innerJoin(services,  eq(services.id,  appointments.serviceId))
  .where(eq(appointments.manageToken, token))
  .all();

if (rows.length === 0) return Astro.redirect('/agendar');

const appt = rows[0];
const startsAt    = new Date(appt.startsAt);
const dateLocal   = formatInTimeZone(startsAt, TZ, 'dd/MM/yyyy');
const timeLocal   = formatInTimeZone(startsAt, TZ, 'HH:mm');

// Dia da semana em português
const WEEKDAYS = ['Domingo','Segunda-feira','Terça-feira','Quarta-feira','Quinta-feira','Sexta-feira','Sábado'];
const dowIndex  = new Date(Date.UTC(...(dateLocal.split('/').reverse().map(Number) as [number,number,number]), 12)).getDay();
const weekday   = WEEKDAYS[dowIndex];

const price       = `R$ ${(appt.priceCents / 100).toFixed(0)}`;
const isConfirmed = appt.status === 'confirmed';
const isCancelled = appt.status === 'cancelled';
const isCompleted = appt.status === 'completed';
const isNoShow    = appt.status === 'no_show';

// WhatsApp para avisar a barbearia
let whatsappUrl = '';
if (WHATSAPP) {
  const msg = `Olá! Agendei *${appt.serviceName}* com *${appt.barberName}* no dia *${dateLocal}* às *${timeLocal}*.`;
  whatsappUrl = `https://wa.me/55${WHATSAPP}?text=${encodeURIComponent(msg)}`;
}
---

<Layout
  title={`Agendamento — ${appt.serviceName} · Barbearia Bayron`}
  description="Gerencie seu agendamento na Barbearia Bayron."
>
  <div class="min-h-screen bg-dark">

    <!-- Header mínimo -->
    <div class="border-b border-white/5 px-4 py-4">
      <div class="max-w-lg mx-auto flex items-center justify-between">
        <a href="/agendar" class="text-neutral-400 hover:text-neutral-200 text-sm flex items-center gap-1.5 transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
          Novo agendamento
        </a>
        <span class="text-neutral-400 text-sm font-medium">Barbearia Bayron</span>
      </div>
    </div>

    <main class="max-w-lg mx-auto px-4 py-10">

      <!-- Ícone de status -->
      <div class="flex flex-col items-center mb-8 text-center">
        {isConfirmed && (
          <div class="w-16 h-16 rounded-full bg-teal/15 border border-teal/30 flex items-center justify-center mb-4">
            <svg class="w-8 h-8 text-teal-light" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
            </svg>
          </div>
          <h1 class="font-serif text-2xl font-medium text-neutral-50">Agendamento confirmado</h1>
          <p class="text-neutral-500 text-sm mt-1">Salve este link para acessar depois</p>
        )}
        {isCancelled && (
          <div class="w-16 h-16 rounded-full bg-red-500/10 border border-red-500/20 flex items-center justify-center mb-4">
            <svg class="w-8 h-8 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </div>
          <h1 class="font-serif text-2xl font-medium text-neutral-50">Agendamento cancelado</h1>
          <p class="text-neutral-500 text-sm mt-1">
            {appt.cancelledBy === 'customer' ? 'Cancelado por você' : 'Cancelado pela barbearia'}
          </p>
        )}
        {(isCompleted || isNoShow) && (
          <div class="w-16 h-16 rounded-full bg-neutral-800 border border-white/10 flex items-center justify-center mb-4">
            <svg class="w-8 h-8 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h1 class="font-serif text-2xl font-medium text-neutral-50">Atendimento concluído</h1>
          <p class="text-neutral-500 text-sm mt-1">Volte sempre!</p>
        )}
      </div>

      <!-- Detalhes do agendamento -->
      <div class="bg-dark-card border border-white/5 rounded-md overflow-hidden mb-6">
        <div class="px-5 py-4 border-b border-white/5">
          <p class="text-xs text-neutral-500 uppercase tracking-widest mb-1">Serviço</p>
          <p class="text-neutral-100 font-medium">{appt.serviceName}</p>
        </div>
        <div class="px-5 py-4 border-b border-white/5">
          <p class="text-xs text-neutral-500 uppercase tracking-widest mb-1">Barbeiro</p>
          <p class="text-neutral-100 font-medium">{appt.barberName}</p>
        </div>
        <div class="px-5 py-4 border-b border-white/5 grid grid-cols-2 gap-4">
          <div>
            <p class="text-xs text-neutral-500 uppercase tracking-widest mb-1">Data</p>
            <p class="text-neutral-100 font-medium">{dateLocal}</p>
            <p class="text-xs text-neutral-500">{weekday}</p>
          </div>
          <div>
            <p class="text-xs text-neutral-500 uppercase tracking-widest mb-1">Horário</p>
            <p class="text-neutral-100 font-medium text-xl">{timeLocal}</p>
            <p class="text-xs text-neutral-500">{appt.durationMinutes} min</p>
          </div>
        </div>
        <div class="px-5 py-4 flex items-center justify-between">
          <p class="text-xs text-neutral-500 uppercase tracking-widest">Valor</p>
          <p class="text-teal-light font-semibold text-lg">{price}</p>
        </div>
      </div>

      <!-- Nome do cliente -->
      <p class="text-center text-neutral-500 text-sm mb-8">
        Agendamento de <span class="text-neutral-300">{appt.customerName}</span>
      </p>

      <!-- Ações (só para agendamentos confirmados) -->
      {isConfirmed && (
        <div class="space-y-3">
          {whatsappUrl && (
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2.5 w-full bg-teal hover:bg-teal-hover text-white font-bold tracking-widest uppercase px-6 py-4 rounded-md transition-colors duration-300 text-sm"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.557 4.123 1.528 5.856L0 24l6.335-1.508A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.89 0-3.659-.5-5.192-1.373l-.373-.22-3.762.896.924-3.659-.241-.386A9.955 9.955 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
              </svg>
              Avisar pelo WhatsApp
            </a>
          )}

          <button
            id="cancel-btn"
            data-token={token}
            class="w-full border border-white/10 hover:border-red-500/40 text-neutral-400 hover:text-red-400 font-medium px-6 py-3.5 rounded-md transition-colors duration-300 text-sm"
          >
            Cancelar agendamento
          </button>
        </div>
      )}

      <!-- Aviso de link -->
      {isConfirmed && (
        <div class="mt-8 flex items-start gap-3 bg-dark-surface border border-white/5 rounded-md px-4 py-3">
          <svg class="w-4 h-4 text-teal-light mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244"/>
          </svg>
          <p class="text-xs text-neutral-500 leading-relaxed">
            Salve o link desta página para acessar ou cancelar este agendamento depois.
          </p>
        </div>
      )}

    </main>
  </div>
</Layout>

<script>
  const CANCEL_BTN_CLASS = 'w-full border border-white/10 hover:border-red-500/40 text-neutral-400 hover:text-red-400 font-medium px-6 py-3.5 rounded-md transition-colors duration-300 text-sm';

  function restoreCancelBtn(token: string) {
    const box = document.getElementById('confirm-cancel');
    if (!box) return;
    box.outerHTML = `<button id="cancel-btn" data-token="${token}" class="${CANCEL_BTN_CLASS}">Cancelar agendamento</button>`;
    attachCancelListener();
  }

  async function doCancel(token: string) {
    const yesBtn = document.getElementById('confirm-yes') as HTMLButtonElement | null;
    if (yesBtn) { yesBtn.textContent = 'Cancelando...'; yesBtn.disabled = true; }

    try {
      const res = await fetch(`/api/appointments/by-token/${token}/cancel`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
      });
      if (res.ok) { location.reload(); return; }
      const data = await res.json();
      alert(data.error ?? 'Erro ao cancelar');
    } catch {
      alert('Erro de conexão. Tente novamente.');
    }
    location.reload();
  }

  function showConfirmation(token: string) {
    const btn = document.getElementById('cancel-btn');
    if (!btn) return;

    btn.outerHTML = `
      <div id="confirm-cancel" class="flex gap-3">
        <button id="confirm-yes"
          class="flex-1 bg-red-600 hover:bg-red-700 text-white font-bold text-sm uppercase tracking-widest px-4 py-3.5 rounded-md transition-colors">
          Sim, cancelar
        </button>
        <button id="confirm-no"
          class="flex-1 border border-white/10 hover:border-white/20 text-neutral-400 hover:text-neutral-200 font-medium text-sm px-4 py-3.5 rounded-md transition-colors">
          Não, voltar
        </button>
      </div>`;

    document.getElementById('confirm-yes')!.addEventListener('click', () => doCancel(token));
    document.getElementById('confirm-no')!.addEventListener('click', () => restoreCancelBtn(token));
  }

  function attachCancelListener() {
    const btn = document.getElementById('cancel-btn') as HTMLButtonElement | null;
    if (btn) btn.addEventListener('click', () => showConfirmation(btn.dataset.token!));
  }

  attachCancelListener();
</script>
