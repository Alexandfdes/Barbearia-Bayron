---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página não encontrada — Barbearia Bayron">
  <main class="min-h-screen bg-dark flex items-center justify-center px-4">
    <div class="text-center max-w-md">
      <p class="text-teal-light text-sm font-medium tracking-[0.25em] uppercase mb-4">404</p>
      <h1 class="font-serif text-4xl md:text-5xl font-medium text-neutral-100 mb-4">
        Página não encontrada
      </h1>
      <p class="text-neutral-500 mb-8">
        O endereço que você acessou não existe ou foi movido.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 bg-teal hover:bg-teal-hover text-white font-bold uppercase tracking-widest px-8 py-3 rounded-sm transition-colors duration-300 text-sm"
      >
        Voltar ao início
      </a>
    </div>
  </main>
</Layout>
