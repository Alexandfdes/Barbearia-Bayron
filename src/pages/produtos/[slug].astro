---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import WhatsAppBar from "../../components/WhatsAppBar.astro";
import { products } from "../../data/products";
import { getWhatsAppUrl } from "../../config";
import "../../styles/global.css";

export async function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;

const productImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/products/*",
  { eager: true }
);
const imgEntry = Object.entries(productImages).find(([path]) =>
  path.endsWith(product.imgFile)
);
const imgSrc = imgEntry?.[1].default;

const whatsappUrl = getWhatsAppUrl(product.whatsappMsg);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  description: product.fullDesc,
  brand: { "@type": "Brand", name: "Boris" },
  offers: {
    "@type": "Offer",
    price: product.priceValue,
    priceCurrency: "BRL",
    availability: "https://schema.org/InStock",
    seller: { "@type": "Organization", name: "Barbearia Bayron" },
  },
};
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={`${product.shortDesc} — Disponível na Barbearia Bayron, Mossoró/RN.`}
    />
    <meta property="og:title" content={`${product.name} | Barbearia Bayron`} />
    <meta
      property="og:description"
      content={`${product.shortDesc} — Disponível na Barbearia Bayron, Mossoró/RN.`}
    />
    <meta property="og:type" content="product" />
    <meta property="og:locale" content="pt_BR" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <title>{product.name} | Barbearia Bayron</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="font-sans bg-dark text-white pb-24 md:pb-0">
    <Header solid />

    <main class="pt-24 min-h-screen">
      <!-- Breadcrumb / back link -->
      <div class="max-w-6xl mx-auto px-6 md:px-10 py-6">
        <a
          href="/#produtos"
          class="inline-flex items-center gap-2 text-sm text-neutral-400 hover:text-teal-light transition-colors duration-200"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 19l-7-7 7-7"></path>
          </svg>
          Todos os Produtos
        </a>
      </div>

      <!-- Product content -->
      <div class="max-w-6xl mx-auto px-6 md:px-10 pb-20">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">

          <!-- Image -->
          <div class="lg:sticky lg:top-28 w-full max-w-[420px] mx-auto lg:max-w-none">
            {imgSrc ? (
              <div class="aspect-square rounded-2xl overflow-hidden bg-neutral-900 border border-white/10">
                <Image
                  src={imgSrc}
                  alt={product.name}
                  widths={[400, 700]}
                  sizes="(max-width: 1024px) 100vw, 50vw"
                  class="w-full h-full object-cover"
                />
              </div>
            ) : (
              <div class="aspect-square rounded-2xl bg-neutral-900 border border-white/10 flex items-center justify-center">
                <span class="text-neutral-600 text-sm">Imagem não disponível</span>
              </div>
            )}
          </div>

          <!-- Info -->
          <div class="flex flex-col">

            <!-- Price badge -->
            <span class="inline-block self-start bg-teal/20 text-teal-light text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-sm mb-4">
              Linha Boris
            </span>

            <h1 class="font-serif text-3xl sm:text-4xl font-semibold leading-tight mb-3">
              {product.name}
            </h1>

            <p class="text-2xl font-bold text-teal-light mb-4">
              {product.price}
            </p>

            <p class="text-sm text-neutral-400 leading-relaxed mb-8">
              {product.shortDesc}
            </p>

            <!-- CTA WhatsApp -->
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center gap-3 bg-[#0f766e] hover:bg-[#0d9488] text-white font-bold uppercase tracking-widest rounded-sm transition-colors duration-300 px-8 py-4 text-sm mb-10"
            >
              <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Pedir pelo WhatsApp
            </a>

            <!-- Divider -->
            <div class="border-t border-white/10 mb-8"></div>

            <!-- Full description -->
            <div class="mb-10">
              <h2 class="text-xs font-bold uppercase tracking-widest text-neutral-500 mb-4">
                Sobre o Produto
              </h2>
              <p class="text-sm text-neutral-300 leading-relaxed">
                {product.fullDesc}
              </p>
            </div>

            <!-- Benefits -->
            <div>
              <h2 class="text-xs font-bold uppercase tracking-widest text-neutral-500 mb-4">
                Benefícios
              </h2>
              <ul class="space-y-3">
                {product.benefits.map((benefit) => (
                  <li class="flex items-start gap-3 text-sm text-neutral-300">
                    <svg
                      class="w-4 h-4 text-teal-light mt-0.5 shrink-0"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2.5"
                      aria-hidden="true"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    {benefit}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </main>

    <Footer />
    <WhatsAppBar />
  </body>
</html>
