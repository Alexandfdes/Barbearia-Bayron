---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import AgendaLista from '../../../components/admin/AgendaLista.astro';
import { getSession } from '../../../lib/session.js';
import { db } from '../../../db/index.js';
import { appointments, barbers, services, timeOff, workingHours } from '../../../db/schema.js';
import { eq, and, gt, gte, lt, or, isNull } from 'drizzle-orm';
import { fromZonedTime, formatInTimeZone } from 'date-fns-tz';
import { waPhone } from '../../../lib/whatsapp.js';
import { computeOccupancy, pickEmptiestBand } from '../../../lib/occupancy.js';

const TZ = 'America/Fortaleza';

// Janela da timeline (hardcoded por enquanto — pode virar dinâmico via working_hours depois).
const START_HOUR = 8;
const END_HOUR   = 19;
const TOTAL_HOURS = END_HOUR - START_HOUR;
// Altura visual de 1 hora controlada por CSS var pra responsividade.
// Veja <style> no template e media query mobile.
// JS lê de getComputedStyle quando precisa (click no buraco).

const session = await getSession(Astro.request);
if (!session) return Astro.redirect('/admin/login');

const { date } = Astro.params;
if (!date || !/^\d{4}-\d{2}-\d{2}$/.test(date)) {
  return Astro.redirect('/admin');
}

const barberRow = db.select({ id: barbers.id, name: barbers.name, role: barbers.role })
  .from(barbers).where(eq(barbers.id, session.barberId)).all()[0];
if (!barberRow) return Astro.redirect('/admin/login');

const barberParam = Astro.url.searchParams.get('barber');
let filterBarberId: number | null = null;
if (session.role === 'admin') {
  if (barberParam) {
    const n = parseInt(barberParam, 10);
    if (!isNaN(n)) filterBarberId = n;
  }
} else {
  filterBarberId = session.barberId;
}

const dayStart = fromZonedTime(`${date}T00:00:00`, TZ).toISOString();
const dayEnd   = fromZonedTime(`${date}T23:59:59`, TZ).toISOString();

const apptRows = db
  .select({
    id:                appointments.id,
    status:            appointments.status,
    startsAt:          appointments.startsAt,
    endsAt:            appointments.endsAt,
    durationMinutes:   appointments.durationMinutes,
    priceCents:        appointments.priceCents,
    customerName:      appointments.customerName,
    customerPhone:     appointments.customerPhone,
    customerBirthdate: appointments.customerBirthdate,
    notes:             appointments.notes,
    lastModifiedById:  appointments.lastModifiedById,
    lastModifiedAt:    appointments.lastModifiedAt,
    barberId:          appointments.barberId,
    barberName:        barbers.name,
    serviceName:       services.name,
  })
  .from(appointments)
  .innerJoin(barbers,  eq(barbers.id,  appointments.barberId))
  .innerJoin(services, eq(services.id, appointments.serviceId))
  .where(
    filterBarberId !== null
      ? and(gte(appointments.startsAt, dayStart), lt(appointments.startsAt, dayEnd), eq(appointments.barberId, filterBarberId))
      : and(gte(appointments.startsAt, dayStart), lt(appointments.startsAt, dayEnd))
  )
  .orderBy(appointments.startsAt)
  .all();

const allBarbers = session.role === 'admin'
  ? db.select({ id: barbers.id, name: barbers.name }).from(barbers).where(eq(barbers.active, true)).all()
  : [];

// Map id→nome de TODOS os barbeiros (ativos + inativos), pra mostrar quem modificou
// mesmo que tenha sido um barbeiro hoje desativado
const barberNameById = new Map<number, string>(
  db.select({ id: barbers.id, name: barbers.name }).from(barbers).all().map(b => [b.id, b.name])
);

// Bloqueios (time_off) que tocam o dia. Filtra por barbeiro respeitando a regra:
// barber_id NULL = feriado pra todos.
const timeOffRows = db
  .select({
    id:       timeOff.id,
    startsAt: timeOff.startsAt,
    endsAt:   timeOff.endsAt,
    reason:   timeOff.reason,
    barberId: timeOff.barberId,
  })
  .from(timeOff)
  .where(
    filterBarberId !== null
      ? and(
          lt(timeOff.startsAt, dayEnd),
          gte(timeOff.endsAt, dayStart),
          or(eq(timeOff.barberId, filterBarberId), isNull(timeOff.barberId))
        )
      : and(
          lt(timeOff.startsAt, dayEnd),
          gte(timeOff.endsAt, dayStart)
        )
  )
  .orderBy(timeOff.startsAt)
  .all();

const nowUtc = new Date();

// Calcula tudo que a timeline precisa por agendamento
interface ApptView {
  id: number;
  status: string;
  durationMinutes: number;
  priceCents: number;
  customerName: string;
  customerPhone: string;
  customerPhoneDisplay: string;
  customerBirthdate: string | null;
  notes: string | null;
  lastModifiedLabel: string | null;
  barberName: string;
  barberId: number;
  serviceName: string;
  timeLocal: string;
  endTimeLocal: string;
  price: string;
  topMin: number;
  durationMin: number;
  /** Telefone normalizado p/ wa.me (55+DDD+número) ou null se inválido */
  wa: string | null;
  telUrl: string;
  isPast: boolean;
  isLate: boolean;
}

interface BlockView {
  id: number;
  reason: string;
  topMin: number;
  durationMin: number;
  timeLocal: string;
  endTimeLocal: string;
}

function formatPhoneDisplay(phone: string): string {
  const d = (phone ?? '').replace(/\D/g, '').slice(-11);
  if (d.length === 11) return `(${d.slice(0,2)}) ${d.slice(2,7)}-${d.slice(7)}`;
  if (d.length === 10) return `(${d.slice(0,2)}) ${d.slice(2,6)}-${d.slice(6)}`;
  return phone;
}

// Calcula topMin/durationMin pra qualquer faixa de horário tocando este dia.
// O posicionamento visual é feito em CSS via calc(var(--hour-px) * topMin / 60).
function timelinePos(startsAtUtc: string, endsAtUtc: string) {
  const sLocal = formatInTimeZone(new Date(startsAtUtc), TZ, 'yyyy-MM-dd HH:mm');
  const eLocal = formatInTimeZone(new Date(endsAtUtc),   TZ, 'yyyy-MM-dd HH:mm');
  const sParts = sLocal.split(' ')[1].split(':').map(Number);
  const eParts = eLocal.split(' ')[1].split(':').map(Number);
  const sIsBefore = sLocal.split(' ')[0] < date;
  const eIsAfter  = eLocal.split(' ')[0] > date;
  const sMin = sIsBefore ? 0 : Math.max(0, (sParts[0] - START_HOUR) * 60 + sParts[1]);
  const eMin = eIsAfter ? TOTAL_HOURS * 60 : Math.min(TOTAL_HOURS * 60, (eParts[0] - START_HOUR) * 60 + eParts[1]);
  return {
    topMin:      sMin,
    durationMin: Math.max(0, eMin - sMin),
  };
}

const apptList: ApptView[] = apptRows.map(a => {
  const pos = timelinePos(a.startsAt, a.endsAt);
  const time     = formatInTimeZone(new Date(a.startsAt), TZ, 'HH:mm');
  const endTime  = formatInTimeZone(new Date(a.endsAt),   TZ, 'HH:mm');
  const wa       = waPhone(a.customerPhone);
  const digits   = (a.customerPhone ?? '').replace(/\D/g, '');
  const telDigits = wa ?? (digits.startsWith('55') ? digits : `55${digits}`);

  return {
    id:              a.id,
    status:          a.status,
    durationMinutes: a.durationMinutes,
    priceCents:      a.priceCents,
    customerName:    a.customerName,
    customerPhone:   a.customerPhone,
    customerPhoneDisplay: formatPhoneDisplay(a.customerPhone),
    customerBirthdate: a.customerBirthdate,
    notes:           a.notes,
    lastModifiedLabel: a.lastModifiedAt && a.lastModifiedById
      ? `${barberNameById.get(a.lastModifiedById) ?? '—'} · ${formatInTimeZone(new Date(a.lastModifiedAt), TZ, "dd/MM 'às' HH:mm")}`
      : null,
    barberName:      a.barberName,
    barberId:        a.barberId,
    serviceName:     a.serviceName,
    timeLocal:       time,
    endTimeLocal:    endTime,
    price:           `R$ ${(a.priceCents / 100).toFixed(0)}`,
    topMin:          pos.topMin,
    durationMin:     pos.durationMin,
    wa,
    telUrl:          `tel:+${telDigits}`,
    isPast:          new Date(a.endsAt) <= nowUtc,
    isLate:          a.status === 'confirmed' && new Date(a.startsAt) < nowUtc,
  };
});

const blockList: BlockView[] = timeOffRows.map(b => {
  const pos = timelinePos(b.startsAt, b.endsAt);
  return {
    id:           b.id,
    reason:       b.reason ?? 'Bloqueado',
    topMin:       pos.topMin,
    durationMin:  pos.durationMin,
    timeLocal:    formatInTimeZone(new Date(b.startsAt), TZ, 'HH:mm'),
    endTimeLocal: formatInTimeZone(new Date(b.endsAt),   TZ, 'HH:mm'),
  };
}).filter(b => b.durationMin > 0);

// Receita prevista: confirmed + completed (não conta cancelled nem no_show)
const revenueCents = apptRows
  .filter(a => a.status === 'confirmed' || a.status === 'completed')
  .reduce((sum, a) => sum + a.priceCents, 0);
const revenueLabel = `R$ ${(revenueCents / 100).toFixed(0)}`;
const revenueCount = apptRows.filter(a => a.status === 'confirmed' || a.status === 'completed').length;

// Próximo agendamento (confirmed que ainda não acabou)
const nextAppt = apptList.find(a => a.status === 'confirmed' && !a.isPast) ?? null;

// Linha "Agora" (em minutos desde START_HOUR)
const todayStr = formatInTimeZone(new Date(), TZ, 'yyyy-MM-dd');
const isToday  = date === todayStr;
let nowTopMin: number | null = null;
if (isToday) {
  const nowHm = formatInTimeZone(nowUtc, TZ, 'HH:mm');
  const [nh, nm] = nowHm.split(':').map(Number);
  const minutesFromStart = (nh - START_HOUR) * 60 + nm;
  if (minutesFromStart >= 0 && minutesFromStart <= TOTAL_HOURS * 60) {
    nowTopMin = minutesFromStart;
  }
}

// Day navigation
function offsetDate(d: string, days: number): string {
  const [y, mo, day] = d.split('-').map(Number);
  const dt = new Date(Date.UTC(y, mo - 1, day + days, 12));
  return dt.toISOString().slice(0, 10);
}
const prevDate = offsetDate(date, -1);
const nextDate = offsetDate(date, 1);

const MONTHS   = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
const WEEKDAYS = ['Domingo','Segunda-feira','Terça-feira','Quarta-feira','Quinta-feira','Sexta-feira','Sábado'];
const [y, m, d] = date.split('-').map(Number);
const dateObj    = new Date(Date.UTC(y, m - 1, d, 12));
const weekday    = WEEKDAYS[dateObj.getDay()];
const formattedDate = `${d} de ${MONTHS[m - 1]} de ${y}`;

// ─── Insight de ocupação da próxima semana (só admin, só na visão de hoje) ────
// "Terça (16/06) de manhã está 80% vazia" — empurra o dado pra onde o dono já olha.
let occupancyInsight: { text: string; pct: number } | null = null;
if (session.role === 'admin' && isToday) {
  const nextDays = Array.from({ length: 7 }, (_, i) => {
    const ds = offsetDate(todayStr, i + 1);
    const [yy, mm, dd] = ds.split('-').map(Number);
    return { dateStr: ds, weekday: new Date(Date.UTC(yy, mm - 1, dd, 12)).getUTCDay() };
  });
  const weekStartIso = fromZonedTime(`${nextDays[0].dateStr}T00:00:00`, TZ).toISOString();
  const weekEndIso   = fromZonedTime(`${nextDays[6].dateStr}T23:59:59`, TZ).toISOString();

  const whRows = db
    .select({ barberId: workingHours.barberId, weekday: workingHours.weekday, startTime: workingHours.startTime, endTime: workingHours.endTime })
    .from(workingHours)
    .innerJoin(barbers, eq(barbers.id, workingHours.barberId))
    .where(eq(barbers.active, true))
    .all();
  const weekAppts = db
    .select({ barberId: appointments.barberId, startsAt: appointments.startsAt, endsAt: appointments.endsAt })
    .from(appointments)
    .where(and(eq(appointments.status, 'confirmed'), gte(appointments.startsAt, weekStartIso), lt(appointments.startsAt, weekEndIso)))
    .all();
  const weekTimeOff = db
    .select({ barberId: timeOff.barberId, startsAt: timeOff.startsAt, endsAt: timeOff.endsAt })
    .from(timeOff)
    .where(and(lt(timeOff.startsAt, weekEndIso), gt(timeOff.endsAt, weekStartIso)))
    .all();

  const occ  = computeOccupancy({ days: nextDays, workingHours: whRows, timeOff: weekTimeOff, appointments: weekAppts });
  const pick = pickEmptiestBand(occ);
  if (pick) {
    const ddmm = pick.dateStr.split('-').reverse().slice(0, 2).join('/');
    occupancyInsight = {
      text: `${WEEKDAYS[pick.weekday]} (${ddmm}) ${pick.bandLabel}`,
      pct:  pick.freePct,
    };
  }
}

const filterQs = filterBarberId ? `?barber=${filterBarberId}` : '';

// Linhas de hora pra render no eixo esquerdo (em "índice de hora" — multiplica por --hour-px no CSS)
const hourLines = Array.from({ length: TOTAL_HOURS + 1 }, (_, i) => ({
  hour:  START_HOUR + i,
  label: `${String(START_HOUR + i).padStart(2, '0')}:00`,
  hourIdx: i,
}));

// Dados leves dos agendamentos pra usar no client (modal de detalhes / reschedule)
const apptsLite = apptList.map(a => ({
  id:                a.id,
  status:            a.status,
  customerName:      a.customerName,
  customerPhone:     a.customerPhone,
  customerPhoneDisplay: a.customerPhoneDisplay,
  customerBirthdate: a.customerBirthdate,
  notes:             a.notes,
  lastModifiedLabel: a.lastModifiedLabel,
  serviceName:       a.serviceName,
  barberName:        a.barberName,
  barberId:          a.barberId,
  durationMinutes:   a.durationMinutes,
  priceCents:        a.priceCents,
  price:             a.price,
  timeLocal:         a.timeLocal,
  endTimeLocal:      a.endTimeLocal,
  wa:                a.wa,
  telUrl:            a.telUrl,
}));

const clientData = {
  date,
  role:              session.role,
  sessionBarberId:   session.barberId,
  filterBarberId,
  allBarbers,
  todayStr,
  appts:             apptsLite,
  startHour:         START_HOUR,
  totalHours:        TOTAL_HOURS,
};
---

<AdminLayout title={`${weekday}, ${formattedDate}`} barberName={barberRow.name} role={session.role}>

  <div id="admin-data-container" data-client={JSON.stringify(clientData)} class="hidden"></div>

  <style is:global>
    .timeline-root { --hour-px: 96px; }
    @media (max-width: 640px) { .timeline-root { --hour-px: 64px; } }

    /* Barra de rolagem discreta no tema escuro (substitui a branca do sistema) */
    .modal-scroll { scrollbar-width: thin; scrollbar-color: #3a3a3a transparent; }
    .modal-scroll::-webkit-scrollbar { width: 8px; }
    .modal-scroll::-webkit-scrollbar-track { background: transparent; }
    .modal-scroll::-webkit-scrollbar-thumb {
      background: #333; border-radius: 9999px; border: 2px solid transparent; background-clip: content-box;
    }
    .modal-scroll::-webkit-scrollbar-thumb:hover { background: #4a4a4a; background-clip: content-box; }
  </style>


  <!-- Date navigation header -->
  <div class="border-b border-white/5 px-4 py-3">
    <div class="max-w-4xl mx-auto flex items-center justify-between gap-3">
      <a href={`/admin/dia/${prevDate}${filterQs}`}
         class="text-neutral-400 hover:text-neutral-200 transition-colors p-2 -ml-2 rounded hover:bg-white/5"
         aria-label="Dia anterior">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
      </a>

      <div class="relative flex items-center gap-3 min-w-0">
        <div class="text-center min-w-0">
          <p class="text-sm font-medium text-neutral-200 truncate">
            {weekday}{isToday && <span class="text-teal-light"> · Hoje</span>}
          </p>
          <p class="text-xs text-neutral-500 truncate">{formattedDate}</p>
        </div>
        <button id="cal-toggle" type="button"
                class="inline-flex items-center text-neutral-400 hover:text-teal-light transition-colors p-1.5 rounded hover:bg-white/5"
                aria-label="Escolher data">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
        </button>

        <!-- Calendário custom popover -->
        <div id="cal-popover"
             class="hidden absolute top-full left-1/2 -translate-x-1/2 mt-2 z-50 bg-dark-card border border-white/10 rounded-lg shadow-2xl shadow-black/50 w-[300px] p-3 select-none">
          <!-- Header: mês/ano e setas -->
          <div class="flex items-center justify-between mb-3 px-1">
            <button id="cal-prev" type="button"
                    class="p-1.5 rounded text-neutral-400 hover:text-neutral-100 hover:bg-white/5 transition-colors"
                    aria-label="Mês anterior">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
              </svg>
            </button>
            <p id="cal-title" class="text-sm font-medium text-neutral-100 tabular-nums">—</p>
            <button id="cal-next" type="button"
                    class="p-1.5 rounded text-neutral-400 hover:text-neutral-100 hover:bg-white/5 transition-colors"
                    aria-label="Próximo mês">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </button>
          </div>

          <!-- Dias da semana -->
          <div class="grid grid-cols-7 gap-1 mb-1 px-1">
            <span class="text-[10px] text-center text-neutral-600 uppercase tracking-wider py-1">D</span>
            <span class="text-[10px] text-center text-neutral-600 uppercase tracking-wider py-1">S</span>
            <span class="text-[10px] text-center text-neutral-600 uppercase tracking-wider py-1">T</span>
            <span class="text-[10px] text-center text-neutral-600 uppercase tracking-wider py-1">Q</span>
            <span class="text-[10px] text-center text-neutral-600 uppercase tracking-wider py-1">Q</span>
            <span class="text-[10px] text-center text-neutral-600 uppercase tracking-wider py-1">S</span>
            <span class="text-[10px] text-center text-neutral-600 uppercase tracking-wider py-1">S</span>
          </div>

          <!-- Grid de dias (renderizado via JS) -->
          <div id="cal-grid" class="grid grid-cols-7 gap-1 px-1"></div>

          <!-- Footer -->
          <div class="flex items-center justify-between mt-3 pt-3 border-t border-white/5 px-1">
            <button id="cal-today" type="button"
                    class="text-xs text-teal-light hover:text-teal font-medium transition-colors">
              Hoje
            </button>
            <button id="cal-close" type="button"
                    class="text-xs text-neutral-500 hover:text-neutral-200 transition-colors">
              Fechar
            </button>
          </div>
        </div>
      </div>

      <a href={`/admin/dia/${nextDate}${filterQs}`}
         class="text-neutral-400 hover:text-neutral-200 transition-colors p-2 -mr-2 rounded hover:bg-white/5"
         aria-label="Próximo dia">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    {!isToday && (
      <div class="max-w-4xl mx-auto mt-2 text-center">
        <a href={`/admin/dia/${todayStr}${filterQs}`}
           class="text-xs text-teal-light hover:text-teal underline-offset-2 hover:underline">
          ← Voltar para hoje
        </a>
      </div>
    )}
  </div>

  <!-- Barber filter tabs (admin only) -->
  {session.role === 'admin' && (
    <div class="border-b border-white/5 px-4 py-2.5 overflow-x-auto">
      <div class="max-w-4xl mx-auto flex gap-2 min-w-max">
        <a href={`/admin/dia/${date}`}
           class:list={['text-xs px-3 py-1.5 rounded-full border transition-colors',
             !filterBarberId ? 'bg-teal/20 border-teal/40 text-teal-light' : 'border-white/10 text-neutral-400 hover:text-neutral-200']}>
          Todos
        </a>
        {allBarbers.map(b => (
          <a href={`/admin/dia/${date}?barber=${b.id}`}
             class:list={['text-xs px-3 py-1.5 rounded-full border transition-colors whitespace-nowrap',
               filterBarberId === b.id ? 'bg-teal/20 border-teal/40 text-teal-light' : 'border-white/10 text-neutral-400 hover:text-neutral-200']}>
            {b.name.split(' ')[0]}
          </a>
        ))}
      </div>
    </div>
  )}

  <main class="max-w-4xl mx-auto px-4 py-6 space-y-5 pb-20">

    <!-- Stats: receita prevista -->
    <section class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <div class="bg-dark-card border border-teal/20 rounded-lg p-4 sm:col-span-2">
        <p class="text-xs text-neutral-500 uppercase tracking-widest">Receita prevista do dia</p>
        <p class="text-3xl font-bold text-teal-light mt-1 tabular-nums">{revenueLabel}</p>
        <p class="text-xs text-neutral-500 mt-0.5">
          {revenueCount} {revenueCount === 1 ? 'agendamento' : 'agendamentos'} considerados (confirmados + concluídos)
        </p>
      </div>
      {nextAppt ? (
        <a href={`#appt-${nextAppt.id}`} class="bg-dark-card border border-white/5 hover:border-teal/30 rounded-lg p-4 transition-colors group">
          <p class="text-xs text-neutral-500 uppercase tracking-widest">Próximo</p>
          <p class="text-xl font-bold text-neutral-100 mt-1 tabular-nums">{nextAppt.timeLocal}</p>
          <p class="text-xs text-neutral-400 mt-0.5 truncate">{nextAppt.customerName}</p>
          <p class="text-xs text-neutral-600 truncate">{nextAppt.serviceName}</p>
        </a>
      ) : (
        <div class="bg-dark-card border border-white/5 rounded-lg p-4 flex flex-col justify-center">
          <p class="text-xs text-neutral-500 uppercase tracking-widest">Próximo</p>
          <p class="text-sm text-neutral-500 mt-1">Sem próximos hoje</p>
        </div>
      )}
    </section>

    <!-- Insight de ocupação da próxima semana (admin) -->
    {occupancyInsight && (
      <div class="bg-dark-card border border-amber-500/20 rounded-lg px-4 py-3 flex items-center gap-3">
        <span class="text-base shrink-0">📉</span>
        <p class="text-xs text-neutral-400 leading-relaxed">
          <span class="text-neutral-200 font-medium">Semana que vem:</span>
          {' '}{occupancyInsight.text} está
          <span class="text-amber-400 font-semibold"> {occupancyInsight.pct}% vazia</span>
          {' '}— bom alvo pra uma promoção.
        </p>
      </div>
    )}

    <!-- Timeline -->
    <section>
      <div class="flex items-center justify-between mb-3 gap-3">
        <p class="text-xs text-neutral-500 uppercase tracking-widest">
          Agenda do dia {apptList.length > 0 && `(${apptList.length})`}
        </p>
        <div class="flex items-center gap-3">
          <p class="text-[10px] text-neutral-600 uppercase tracking-widest hidden sm:block">
            {String(START_HOUR).padStart(2, '0')}:00 → {String(END_HOUR).padStart(2, '0')}:00
          </p>
        </div>
      </div>

      {(apptList.length === 0 && blockList.length === 0) ? (
        <div class="bg-dark-card border border-white/5 rounded-lg py-14 px-6 flex flex-col items-center text-center">
          <svg class="w-10 h-10 text-neutral-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <p class="text-sm font-medium text-neutral-300 mt-3">Nenhum agendamento para este dia</p>
          <p class="text-xs text-neutral-500 mt-1">
            Dia livre · expediente {String(START_HOUR).padStart(2, '0')}:00 → {String(END_HOUR).padStart(2, '0')}:00
          </p>
          <div class="flex flex-wrap gap-2 mt-5 justify-center">
            <button type="button" data-empty-manual
              class="flex items-center gap-2 text-xs px-4 py-2 bg-teal hover:bg-teal-hover text-white font-bold uppercase tracking-widest rounded transition-colors">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
              </svg>
              Agendar
            </button>
            <button type="button" data-empty-block
              class="flex items-center gap-2 text-xs px-4 py-2 border border-white/10 hover:border-red-500/30 text-neutral-400 hover:text-red-400 rounded transition-colors">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
              </svg>
              Bloquear horário
            </button>
          </div>
        </div>
      ) : (
        <div class="space-y-2">
          {blockList.map(b => (
            <div class="flex items-center gap-3 bg-dark-card border border-white/10 border-l-[3px] border-l-neutral-600/60 rounded-md px-4 py-3">
              <div class="w-12 shrink-0">
                <p class="text-sm font-bold tabular-nums text-neutral-400">{b.timeLocal}</p>
                <p class="text-[10px] text-neutral-600 tabular-nums">{b.endTimeLocal}</p>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-neutral-400 truncate">{b.reason || 'Horário bloqueado'}</p>
                <p class="text-[10px] text-neutral-600 uppercase tracking-widest">Bloqueio</p>
              </div>
            </div>
          ))}
          <AgendaLista appts={apptList} role={session.role} />
        </div>
      )}
    </section>

    <!-- Bottom action buttons -->
    <div class="flex gap-3">
      <button id="btn-manual"
        class="flex-1 flex items-center justify-center gap-2 border border-white/10 hover:border-teal/30 text-neutral-400 hover:text-teal-light text-sm font-medium py-3 rounded-md transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
        </svg>
        Agendamento manual
      </button>
      <button id="btn-block"
        class="flex-1 flex items-center justify-center gap-2 border border-white/10 hover:border-red-500/30 text-neutral-400 hover:text-red-400 text-sm font-medium py-3 rounded-md transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
        </svg>
        Bloquear horário
      </button>
    </div>

    <!-- Manual booking form -->
    <div id="form-manual" class="hidden border border-teal/20 bg-dark-card rounded-md p-5 space-y-4">
      <div class="flex items-center justify-between">
        <p class="text-sm font-medium text-neutral-200">Novo agendamento manual</p>
        <button id="close-manual" class="text-neutral-500 hover:text-neutral-300 text-xs transition-colors">✕ fechar</button>
      </div>

      {session.role === 'admin' && (
        <div>
          <label class="block text-xs text-neutral-500 uppercase tracking-widest mb-1.5">Barbeiro</label>
          <select id="m-barber" class="w-full bg-dark-surface border border-white/10 rounded px-3 py-2 text-sm text-neutral-200 focus:outline-none focus:border-teal/50">
            <option value="">Selecione</option>
            {allBarbers.map(b => (
              <option value={String(b.id)}>{b.name.split(' ')[0]}</option>
            ))}
          </select>
        </div>
      )}

      <div>
        <label class="block text-xs text-neutral-500 uppercase tracking-widest mb-1.5">Serviço</label>
        <select id="m-service" class="w-full bg-dark-surface border border-white/10 rounded px-3 py-2 text-sm text-neutral-200 focus:outline-none focus:border-teal/50">
          <option value="">Selecione</option>
        </select>
      </div>

      <div>
        <label class="block text-xs text-neutral-500 uppercase tracking-widest mb-1.5">Horário disponível</label>
        <div id="m-slots-wrap" class="text-xs text-neutral-500">
          Selecione barbeiro e serviço primeiro.
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs text-neutral-500 uppercase tracking-widest mb-1.5">Nome do cliente</label>
          <input id="m-name" type="text" placeholder="Nome completo"
            class="w-full bg-dark-surface border border-white/10 rounded px-3 py-2 text-sm text-neutral-200 placeholder-neutral-600 focus:outline-none focus:border-teal/50" />
        </div>
        <div>
          <label class="block text-xs text-neutral-500 uppercase tracking-widest mb-1.5">WhatsApp</label>
          <input id="m-phone" type="tel" placeholder="(84) 9xxxx-xxxx"
            class="w-full bg-dark-surface border border-white/10 rounded px-3 py-2 text-sm text-neutral-200 placeholder-neutral-600 focus:outline-none focus:border-teal/50" />
        </div>
      </div>

      <div id="m-error" class="hidden text-red-400 text-xs text-center py-1"></div>

      <button id="m-submit"
        class="w-full bg-teal hover:bg-teal-hover text-white font-bold uppercase tracking-widest py-3 rounded transition-colors text-sm disabled:opacity-50">
        Confirmar agendamento
      </button>
    </div>

    <!-- Block time form -->
    <div id="form-block" class="hidden border border-red-500/20 bg-dark-card rounded-md p-5 space-y-4">
      <div class="flex items-center justify-between">
        <p class="text-sm font-medium text-neutral-200">Bloquear horário</p>
        <button id="close-block" class="text-neutral-500 hover:text-neutral-300 text-xs transition-colors">✕ fechar</button>
      </div>

      {session.role === 'admin' && (
        <div>
          <label class="block text-xs text-neutral-500 uppercase tracking-widest mb-1.5">Aplicar para</label>
          <select id="b-barber" class="w-full bg-dark-surface border border-white/10 rounded px-3 py-2 text-sm text-neutral-200 focus:outline-none focus:border-teal/50">
            <option value="">Todos (feriado)</option>
            {allBarbers.map(b => (
              <option value={String(b.id)}>{b.name.split(' ')[0]}</option>
            ))}
          </select>
        </div>
      )}

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs text-neutral-500 uppercase tracking-widest mb-1.5">Início</label>
          <input id="b-start" type="time" value="09:00"
            class="w-full bg-dark-surface border border-white/10 rounded px-3 py-2 text-sm text-neutral-200 focus:outline-none focus:border-teal/50" />
        </div>
        <div>
          <label class="block text-xs text-neutral-500 uppercase tracking-widest mb-1.5">Fim</label>
          <input id="b-end" type="time" value="18:00"
            class="w-full bg-dark-surface border border-white/10 rounded px-3 py-2 text-sm text-neutral-200 focus:outline-none focus:border-teal/50" />
        </div>
      </div>

      <div>
        <label class="block text-xs text-neutral-500 uppercase tracking-widest mb-1.5">Motivo (opcional)</label>
        <input id="b-reason" type="text" placeholder="ex: Almoço, Folga, Feriado..."
          class="w-full bg-dark-surface border border-white/10 rounded px-3 py-2 text-sm text-neutral-200 placeholder-neutral-600 focus:outline-none focus:border-teal/50" />
      </div>

      <div id="b-error" class="hidden text-red-400 text-xs text-center py-1"></div>

      <button id="b-submit"
        class="w-full bg-red-600 hover:bg-red-700 text-white font-bold uppercase tracking-widest py-3 rounded transition-colors text-sm disabled:opacity-50">
        Bloquear
      </button>
    </div>

  </main>

  <!-- ============ MODAIS ============ -->

  <!-- Modal de confirmação genérico (cancelar etc.) -->
  <div id="confirm-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm">
    <div class="bg-dark-card border border-white/10 rounded-lg shadow-2xl max-w-sm w-full p-6">
      <p id="confirm-title" class="text-base font-medium text-neutral-100 mb-2">Confirmar?</p>
      <p id="confirm-message" class="text-sm text-neutral-400 mb-5 leading-relaxed">Tem certeza?</p>
      <div class="flex gap-2 justify-end">
        <button id="confirm-cancel"
                class="px-4 py-2 rounded text-sm font-medium text-neutral-300 border border-white/10 hover:bg-white/5 transition-colors">
          Voltar
        </button>
        <button id="confirm-ok"
                class="px-4 py-2 rounded text-sm font-bold text-white bg-red-600 hover:bg-red-700 transition-colors">
          Confirmar
        </button>
      </div>
    </div>
  </div>

  <!-- Modal de detalhes do agendamento -->
  <div id="detail-modal" class="hidden fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 bg-black/70 backdrop-blur-sm">
    <div class="modal-scroll bg-dark-card border border-white/10 rounded-t-lg sm:rounded-lg shadow-2xl w-full max-w-md sm:max-w-2xl lg:max-w-4xl max-h-[90vh] overflow-y-auto">
      <!-- Header -->
      <div class="flex items-start justify-between gap-4 p-5 border-b border-white/5">
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-2 min-w-0">
            <p id="dm-name" class="text-lg font-bold text-neutral-100 truncate">—</p>
            <span id="dm-birthday" class="hidden shrink-0 text-[10px] font-bold text-amber-200 bg-amber-500/15 border border-amber-400/30 px-1.5 py-0.5 rounded-full whitespace-nowrap"></span>
          </div>
          <p id="dm-service" class="text-sm text-neutral-400 truncate">—</p>
        </div>
        <button id="dm-close" class="text-neutral-500 hover:text-neutral-200 text-xl leading-none -mt-1 -mr-1 p-1">×</button>
      </div>

      <!-- Info -->
      <div class="p-5">
       <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-4 items-start">
        <!-- Coluna 1: info, ficha, contato, notas -->
        <div class="space-y-4">
        <!-- Horário + duração + valor -->
        <div class="grid grid-cols-3 gap-3 text-center">
          <div class="bg-dark-surface border border-white/5 rounded p-3">
            <p class="text-[10px] text-neutral-500 uppercase tracking-widest">Horário</p>
            <p id="dm-time" class="text-base font-bold text-teal-light tabular-nums mt-1">—</p>
          </div>
          <div class="bg-dark-surface border border-white/5 rounded p-3">
            <p class="text-[10px] text-neutral-500 uppercase tracking-widest">Duração</p>
            <p id="dm-duration" class="text-base font-bold text-neutral-200 tabular-nums mt-1">—</p>
          </div>
          <div class="bg-dark-surface border border-white/5 rounded p-3">
            <p class="text-[10px] text-neutral-500 uppercase tracking-widest">Valor</p>
            <p id="dm-price" class="text-base font-bold text-neutral-200 tabular-nums mt-1">—</p>
          </div>
        </div>

        <!-- Ficha do cliente -->
        <div>
          <p class="text-[10px] text-neutral-500 uppercase tracking-widest mb-1.5">Cliente</p>
          <div id="dm-stats" class="text-xs text-neutral-600 italic">Carregando…</div>
        </div>

        <!-- Contato -->
        <div>
          <p class="text-[10px] text-neutral-500 uppercase tracking-widest mb-1.5">Contato</p>
          <div class="flex items-center gap-2">
            <a id="dm-tel" href="#"
               class="flex-1 bg-dark-surface border border-white/5 hover:border-teal/30 rounded px-3 py-2 text-sm text-neutral-200 tabular-nums transition-colors flex items-center gap-2">
              <svg class="w-4 h-4 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              <span id="dm-phone">—</span>
            </a>
            <button id="dm-copy-phone" type="button"
                    class="px-2.5 py-2 rounded border border-white/10 hover:border-teal/30 text-neutral-400 hover:text-teal-light transition-colors text-xs"
                    title="Copiar telefone">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
            </button>
            <button id="dm-whatsapp" type="button" data-action="wa-menu" data-id=""
               class="px-2.5 py-2 rounded border border-green-500/30 hover:bg-green-500/10 text-green-400 transition-colors"
               title="Mensagens rápidas no WhatsApp">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Notas -->
        <div>
          <p class="text-[10px] text-neutral-500 uppercase tracking-widest mb-1.5">Notas internas</p>
          <textarea id="dm-notes" rows="3" placeholder="Ex: alérgico a barba feita com lâmina..."
                    class="w-full bg-dark-surface border border-white/10 focus:border-teal/40 rounded px-3 py-2 text-sm text-neutral-200 placeholder-neutral-600 outline-none resize-none transition-colors"></textarea>
          <div class="flex items-center justify-between mt-1.5 h-4">
            <span id="dm-notes-status" class="text-[10px] text-neutral-600"></span>
            <button id="dm-notes-save"
                    class="text-[10px] text-teal-light hover:text-teal font-medium uppercase tracking-widest hidden">
              Salvar notas
            </button>
          </div>
        </div>
        </div><!-- /coluna 1 -->

        <!-- Coluna 2: histórico + editar -->
        <div class="space-y-4">
        <!-- Histórico do cliente -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <p class="text-[10px] text-neutral-500 uppercase tracking-widest">Histórico</p>
            <span id="dm-history-count" class="text-[10px] text-neutral-600 tabular-nums"></span>
          </div>
          <div id="dm-history" class="space-y-1.5 text-xs">
            <p class="text-neutral-600 italic">Carregando...</p>
          </div>
        </div>

        <!-- Editar cliente (collapsible) -->
        <details class="group">
          <summary class="cursor-pointer text-[10px] text-neutral-500 hover:text-neutral-300 uppercase tracking-widest list-none flex items-center gap-1 transition-colors">
            <svg class="w-3 h-3 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
            Editar dados do cliente
          </summary>
          <div class="mt-3 space-y-2 border-l border-white/5 pl-3">
            <div>
              <label class="block text-[10px] text-neutral-500 uppercase tracking-widest mb-1">Nome completo</label>
              <input id="dm-edit-name" type="text"
                     class="w-full bg-dark-surface border border-white/10 focus:border-teal/40 rounded px-3 py-2 text-sm text-neutral-200 outline-none transition-colors" />
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="block text-[10px] text-neutral-500 uppercase tracking-widest mb-1">Telefone</label>
                <input id="dm-edit-phone" type="tel" inputmode="numeric" maxlength="16" placeholder="(84) 99999-9999"
                       class="w-full bg-dark-surface border border-white/10 focus:border-teal/40 rounded px-3 py-2 text-sm text-neutral-200 tabular-nums outline-none transition-colors" />
              </div>
              <div>
                <label class="block text-[10px] text-neutral-500 uppercase tracking-widest mb-1">Nascimento</label>
                <input id="dm-edit-birthdate" type="text" inputmode="numeric" maxlength="10" placeholder="dd/mm/aaaa"
                       class="w-full bg-dark-surface border border-white/10 focus:border-teal/40 rounded px-3 py-2 text-sm text-neutral-200 tabular-nums outline-none transition-colors" />
              </div>
            </div>
            <p class="text-[10px] text-neutral-600 leading-relaxed">
              A alteração propaga pra todos os agendamentos com este telefone.
            </p>
            <div class="flex items-center justify-between h-5">
              <span id="dm-edit-status" class="text-[10px] text-neutral-600"></span>
              <button id="dm-edit-save"
                      class="text-[10px] text-teal-light hover:text-teal font-medium uppercase tracking-widest hidden">
                Salvar
              </button>
            </div>
          </div>
        </details>
        </div><!-- /coluna 2 -->

        <!-- Coluna 3: mover horário (ocupa a largura toda quando só há 2 colunas) -->
        <div class="space-y-4 sm:col-span-2 lg:col-span-1">
        <!-- Mover horário -->
        <div>
          <p class="text-[10px] text-neutral-500 uppercase tracking-widest mb-1.5">Mover horário</p>
          <div class="space-y-2">
            <input id="dm-move-date" type="date"
                   class="w-full bg-dark-surface border border-white/10 focus:border-teal/40 rounded px-3 py-2 text-sm text-neutral-200 outline-none transition-colors" />
            <div id="dm-move-slots" class="text-xs text-neutral-500 min-h-[2rem]">
              Selecione uma data acima.
            </div>
            <button id="dm-move-confirm" disabled
                    class="w-full bg-teal hover:bg-teal-hover text-white text-xs font-bold uppercase tracking-widest py-2 rounded transition-colors disabled:opacity-30 disabled:cursor-not-allowed">
              Confirmar reagendamento
            </button>
          </div>
        </div>
        </div><!-- /coluna 3 -->
       </div><!-- /grid -->
      </div>

      <!-- Última modificação (auditoria) -->
      <div id="dm-audit" class="hidden px-5 pb-2 -mt-2">
        <p class="text-[10px] text-neutral-600">
          Última alteração: <span id="dm-audit-text" class="text-neutral-500">—</span>
        </p>
      </div>

      <!-- Footer com ações principais (fixo no rodapé do modal) -->
      <div class="border-t border-white/5 p-4 flex gap-2 sticky bottom-0 bg-dark-card z-10">
        <button data-action="complete" data-id="" id="dm-complete"
                class="flex-1 border border-teal/30 hover:bg-teal/15 text-teal-light text-xs font-bold uppercase tracking-widest py-2.5 rounded transition-colors">
          ✓ Concluir
        </button>
        <button data-action="no-show" data-id="" id="dm-noshow"
                class="flex-1 border border-amber-500/25 hover:bg-amber-500/10 text-amber-400 text-xs font-bold uppercase tracking-widest py-2.5 rounded transition-colors">
          No-show
        </button>
        <button data-action="cancel" data-id="" id="dm-cancel"
                class="flex-1 border border-red-500/25 hover:bg-red-500/10 text-red-400 text-xs font-bold uppercase tracking-widest py-2.5 rounded transition-colors">
          Cancelar
        </button>
      </div>
    </div>
  </div>

  <!-- Modal: fechar comanda -->
  <div id="comanda-modal" class="hidden fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 bg-black/70 backdrop-blur-sm">
    <div class="bg-dark-card border border-white/10 rounded-t-2xl sm:rounded-2xl w-full sm:max-w-md max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between px-5 py-4 border-b border-white/5">
        <div class="min-w-0">
          <h3 class="text-base font-medium text-neutral-100">Fechar atendimento</h3>
          <p id="cm-appt" class="text-xs text-neutral-500 mt-0.5 truncate">—</p>
        </div>
        <button id="cm-close" class="text-neutral-500 hover:text-neutral-300 shrink-0 ml-3" aria-label="Fechar">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <div class="px-5 py-4 space-y-4">
        <div class="flex items-center justify-between text-sm">
          <span id="cm-main-name" class="text-neutral-300 truncate">Serviço</span>
          <span id="cm-main-price" class="text-neutral-200 tabular-nums shrink-0 ml-3">R$ 0</span>
        </div>

        <div>
          <label class="block text-xs text-neutral-500 uppercase tracking-widest mb-1.5">Adicionar serviço extra</label>
          <div class="flex gap-2">
            <select id="cm-extra-select" class="flex-1 min-w-0 bg-dark-surface border border-white/10 rounded px-3 py-2 text-sm text-neutral-200 focus:outline-none focus:border-teal/50">
              <option value="">Selecione…</option>
            </select>
            <button id="cm-extra-add" class="shrink-0 px-3 py-2 border border-teal/30 text-teal-light text-sm rounded hover:bg-teal/10 transition-colors">Adicionar</button>
          </div>
        </div>

        <div id="cm-extras" class="space-y-2"></div>

        <div class="flex items-center justify-between pt-3 border-t border-white/5">
          <span class="text-sm text-neutral-400">Total</span>
          <span id="cm-total" class="text-lg font-bold text-teal-light tabular-nums">R$ 0</span>
        </div>
      </div>

      <div class="flex gap-2 px-5 py-4 border-t border-white/5">
        <button id="cm-confirm" class="flex-1 bg-teal hover:bg-teal-hover text-white font-bold uppercase tracking-widest py-2.5 rounded text-xs transition-colors">Concluir e fechar</button>
        <button id="cm-cancel" class="px-4 border border-white/10 text-neutral-400 hover:text-neutral-200 rounded text-xs transition-colors">Cancelar</button>
      </div>
    </div>
  </div>

  <!-- Modal: ação rápida no espaço vazio da timeline -->
  <div id="express-modal" class="hidden fixed inset-0 z-[60] flex items-end sm:items-center justify-center p-0 sm:p-4 bg-black/70 backdrop-blur-sm">
    <div class="bg-dark-card border border-white/10 rounded-t-lg sm:rounded-lg shadow-2xl max-w-sm w-full p-5">
      <div class="flex items-start justify-between gap-3 mb-4">
        <p class="text-sm font-medium text-neutral-100">
          <span id="ex-time" class="text-teal-light tabular-nums">—</span> — o que fazer?
        </p>
        <button id="ex-close" type="button" class="text-neutral-500 hover:text-neutral-200 text-xl leading-none -mt-1 -mr-1 p-1">×</button>
      </div>

      <div class="space-y-2">
        <button id="ex-agendar" type="button"
           class="w-full text-left bg-dark-surface border border-white/5 hover:border-teal/40 rounded-md px-3 py-2.5 transition-colors group">
          <p class="text-sm font-medium text-neutral-200 group-hover:text-teal-light transition-colors">📅 Encaixar cliente</p>
          <p class="text-[11px] text-neutral-500 mt-0.5">Barbeiro e horário já preenchidos — só escolher serviço, nome e telefone</p>
        </button>
        <button id="ex-block-30" type="button" data-ex-minutes="30"
           class="w-full text-left bg-dark-surface border border-white/5 hover:border-red-500/40 rounded-md px-3 py-2.5 transition-colors group disabled:opacity-40 disabled:cursor-not-allowed">
          <p class="text-sm font-medium text-neutral-200 group-hover:text-red-400 transition-colors">☕ Bloquear 30 min</p>
          <p class="text-[11px] text-neutral-500 mt-0.5">Café, descanso, encaixe pessoal</p>
        </button>
        <button id="ex-block-60" type="button" data-ex-minutes="60"
           class="w-full text-left bg-dark-surface border border-white/5 hover:border-red-500/40 rounded-md px-3 py-2.5 transition-colors group disabled:opacity-40 disabled:cursor-not-allowed">
          <p class="text-sm font-medium text-neutral-200 group-hover:text-red-400 transition-colors">🍽️ Bloquear 1 hora</p>
          <p class="text-[11px] text-neutral-500 mt-0.5">Almoço, emergência</p>
        </button>
      </div>

      <p id="ex-hint" class="hidden text-[11px] text-amber-400/80 mt-3">
        Na visão "Todos", filtre por um barbeiro para usar o bloqueio rápido.
      </p>
    </div>
  </div>

  <!-- Modal: mensagens rápidas WhatsApp -->
  <div id="wa-modal" class="hidden fixed inset-0 z-[60] flex items-end sm:items-center justify-center p-0 sm:p-4 bg-black/70 backdrop-blur-sm">
    <div class="bg-dark-card border border-white/10 rounded-t-lg sm:rounded-lg shadow-2xl max-w-sm w-full p-5">
      <div class="flex items-start justify-between gap-3 mb-1">
        <p class="text-sm font-medium text-neutral-100">Enviar WhatsApp</p>
        <button id="wa-close" type="button" class="text-neutral-500 hover:text-neutral-200 text-xl leading-none -mt-1 -mr-1 p-1">×</button>
      </div>
      <p id="wa-sub" class="text-xs text-neutral-500 mb-4 truncate">—</p>

      <div class="space-y-2">
        <a id="wa-opt-lembrete" href="#" target="_blank" rel="noopener"
           class="block bg-dark-surface border border-white/5 hover:border-green-500/40 rounded-md px-3 py-2.5 transition-colors group">
          <p class="text-sm font-medium text-neutral-200 group-hover:text-green-400 transition-colors">🔔 Lembrete do horário</p>
          <p data-wa-preview class="text-[11px] text-neutral-500 mt-0.5 line-clamp-2">—</p>
        </a>
        <a id="wa-opt-atraso-cliente" href="#" target="_blank" rel="noopener"
           class="block bg-dark-surface border border-white/5 hover:border-green-500/40 rounded-md px-3 py-2.5 transition-colors group">
          <p class="text-sm font-medium text-neutral-200 group-hover:text-green-400 transition-colors">🏃 Cliente atrasado — está a caminho?</p>
          <p data-wa-preview class="text-[11px] text-neutral-500 mt-0.5 line-clamp-2">—</p>
        </a>
        <a id="wa-opt-atraso-barbeiro" href="#" target="_blank" rel="noopener"
           class="block bg-dark-surface border border-white/5 hover:border-green-500/40 rounded-md px-3 py-2.5 transition-colors group">
          <p class="text-sm font-medium text-neutral-200 group-hover:text-green-400 transition-colors">⏳ Avisar meu atraso (+15 min)</p>
          <p data-wa-preview class="text-[11px] text-neutral-500 mt-0.5 line-clamp-2">—</p>
        </a>
        <a id="wa-opt-livre" href="#" target="_blank" rel="noopener"
           class="block bg-dark-surface border border-white/5 hover:border-green-500/40 rounded-md px-3 py-2.5 transition-colors group">
          <p class="text-sm font-medium text-neutral-200 group-hover:text-green-400 transition-colors">💬 Conversa em branco</p>
          <p class="text-[11px] text-neutral-500 mt-0.5">Abre o chat sem mensagem pronta</p>
        </a>
      </div>
    </div>
  </div>

  <!-- Toast container -->
  <div id="toast-container" class="fixed bottom-4 right-4 z-50 space-y-2 pointer-events-none"></div>

</AdminLayout>

<script>
  import { waPhone, waLink, buildWaMessages } from '../../../lib/whatsapp';

  const container = document.getElementById('admin-data-container')!;
  const clientData = JSON.parse(container.dataset.client!);
  const { date, role, sessionBarberId, filterBarberId, allBarbers } = clientData;

  // ─── Calendário custom ──────────────────────────────────────────────────────
  (function setupCalendar() {
    const toggle  = document.getElementById('cal-toggle');
    const popover = document.getElementById('cal-popover');
    const title   = document.getElementById('cal-title');
    const grid    = document.getElementById('cal-grid');
    const prev    = document.getElementById('cal-prev');
    const next    = document.getElementById('cal-next');
    const todayBtn= document.getElementById('cal-today');
    const closeBtn= document.getElementById('cal-close');
    if (!toggle || !popover || !title || !grid || !prev || !next || !todayBtn || !closeBtn) return;

    const MONTHS = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
    const qs = filterBarberId ? `?barber=${filterBarberId}` : '';

    // Mês visualizado, com base na data da página
    const [py, pm] = date.split('-').map(Number);
    let viewYear  = py;
    let viewMonth = pm - 1; // 0-based

    // Hoje no fuso local do navegador (basta pra destacar visualmente)
    const now = new Date();
    const todayY = now.getFullYear();
    const todayM = now.getMonth();
    const todayD = now.getDate();

    function pad(n) { return String(n).padStart(2, '0'); }
    function fmt(y, m, d) { return `${y}-${pad(m + 1)}-${pad(d)}`; }

    // Cache: "YYYY-MM" -> { "YYYY-MM-DD": qty }
    const monthCache = new Map();

    async function fetchMonth(yyyymm) {
      if (monthCache.has(yyyymm)) return monthCache.get(yyyymm);
      try {
        const params = new URLSearchParams({ month: yyyymm });
        if (filterBarberId) params.set('barber', String(filterBarberId));
        const res = await fetch(`/api/admin/appointments/calendar?${params}`);
        if (!res.ok) return {};
        const data = await res.json();
        const days = data.days ?? {};
        monthCache.set(yyyymm, days);
        return days;
      } catch {
        return {};
      }
    }

    async function render() {
      title.textContent = `${MONTHS[viewMonth]} ${viewYear}`;
      grid.innerHTML = '';

      const firstOfMonth = new Date(viewYear, viewMonth, 1);
      const startDow     = firstOfMonth.getDay(); // 0 = domingo
      const daysInMonth  = new Date(viewYear, viewMonth + 1, 0).getDate();
      const daysInPrev   = new Date(viewYear, viewMonth, 0).getDate();

      // Busca contagem em paralelo: mês atual + adjacentes (pros dias de overflow)
      const ymCur  = `${viewYear}-${pad(viewMonth + 1)}`;
      const prevM  = viewMonth === 0 ? 11 : viewMonth - 1;
      const prevY  = viewMonth === 0 ? viewYear - 1 : viewYear;
      const nextM  = viewMonth === 11 ? 0 : viewMonth + 1;
      const nextY  = viewMonth === 11 ? viewYear + 1 : viewYear;
      const ymPrev = `${prevY}-${pad(prevM + 1)}`;
      const ymNext = `${nextY}-${pad(nextM + 1)}`;

      const [daysCur, daysPrev, daysNext] = await Promise.all([
        fetchMonth(ymCur), fetchMonth(ymPrev), fetchMonth(ymNext),
      ]);
      const allDays = { ...daysPrev, ...daysCur, ...daysNext };

      // Total de células: sempre 6 linhas pra altura consistente
      const totalCells = 42;
      for (let i = 0; i < totalCells; i++) {
        const cell = document.createElement('button');
        cell.type = 'button';
        cell.className = 'relative aspect-square text-xs rounded flex flex-col items-center justify-center tabular-nums transition-colors';

        let cellY, cellM, cellD;
        let inMonth = true;

        if (i < startDow) {
          cellD = daysInPrev - (startDow - 1 - i);
          cellM = prevM;
          cellY = prevY;
          inMonth = false;
        } else if (i >= startDow + daysInMonth) {
          cellD = i - (startDow + daysInMonth) + 1;
          cellM = nextM;
          cellY = nextY;
          inMonth = false;
        } else {
          cellD = i - startDow + 1;
          cellM = viewMonth;
          cellY = viewYear;
        }

        const dateStr = fmt(cellY, cellM, cellD);
        cell.dataset.date = dateStr;

        const isToday    = cellY === todayY && cellM === todayM && cellD === todayD;
        const isSelected = dateStr === date;
        const isSunday   = (i % 7) === 0;
        const qty        = allDays[dateStr] ?? 0;

        // Número do dia
        const num = document.createElement('span');
        num.textContent = String(cellD);
        cell.appendChild(num);

        // Ponto indicador
        if (qty > 0) {
          const dot = document.createElement('span');
          dot.className = 'absolute bottom-1 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full';
          // Cor depende do estado da célula pra contrastar
          if (isSelected) {
            dot.className += ' bg-white';
          } else if (!inMonth) {
            dot.className += ' bg-teal/40';
          } else {
            dot.className += ' bg-teal-light';
          }
          cell.appendChild(dot);
          cell.title = `${qty} agendamento${qty > 1 ? 's' : ''}`;
        }

        if (isSelected) {
          cell.className += ' bg-teal text-white font-bold ring-2 ring-teal/30';
        } else if (isToday) {
          cell.className += ' border border-teal/50 text-teal-light font-semibold hover:bg-teal/10';
        } else if (!inMonth) {
          cell.className += ' text-neutral-700 hover:bg-white/5';
        } else if (isSunday) {
          cell.className += ' text-neutral-500 hover:bg-white/5';
        } else {
          cell.className += ' text-neutral-300 hover:bg-white/10';
        }

        cell.addEventListener('click', () => {
          location.href = `/admin/dia/${dateStr}${qs}`;
        });

        grid.appendChild(cell);
      }
    }

    function open() {
      popover.classList.remove('hidden');
      render();
    }
    function close() {
      popover.classList.add('hidden');
    }
    function toggleOpen() {
      popover.classList.contains('hidden') ? open() : close();
    }

    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleOpen();
    });
    closeBtn.addEventListener('click', close);

    prev.addEventListener('click', () => {
      if (viewMonth === 0) { viewMonth = 11; viewYear--; } else viewMonth--;
      render();
    });
    next.addEventListener('click', () => {
      if (viewMonth === 11) { viewMonth = 0; viewYear++; } else viewMonth++;
      render();
    });
    todayBtn.addEventListener('click', () => {
      location.href = `/admin/dia/${fmt(todayY, todayM, todayD)}${qs}`;
    });

    // Fecha ao clicar fora
    document.addEventListener('click', (e) => {
      if (popover.classList.contains('hidden')) return;
      if (popover.contains(e.target) || toggle.contains(e.target)) return;
      close();
    });
    // ESC fecha
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !popover.classList.contains('hidden')) close();
    });
  })();

  // ─── Helpers ────────────────────────────────────────────────────────────────
  function localTimeToUtcIso(dateStr, timeStr) {
    const [y, mo, d]   = dateStr.split('-').map(Number);
    const [h, min]     = timeStr.split(':').map(Number);
    const utc          = new Date(Date.UTC(y, mo - 1, d, h + 3, min));
    return utc.toISOString();
  }

  async function callApi(endpoint, method = 'POST', body = undefined) {
    const res = await fetch(endpoint, {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: body ? JSON.stringify(body) : undefined,
    });
    return { ok: res.ok, data: await res.json() };
  }

  // ─── Toast ──────────────────────────────────────────────────────────────────
  function toast(msg, kind = 'info') {
    const container = document.getElementById('toast-container');
    if (!container) return;
    const el = document.createElement('div');
    const color = kind === 'error'   ? 'border-red-500/30 bg-red-950/80 text-red-200'
               : kind === 'success' ? 'border-teal/30 bg-teal/15 text-teal-light'
               :                       'border-white/10 bg-dark-card text-neutral-200';
    el.className = `pointer-events-auto px-4 py-2.5 rounded-md border backdrop-blur-sm text-sm shadow-lg transition-all duration-300 ${color}`;
    el.textContent = msg;
    el.style.opacity = '0';
    el.style.transform = 'translateY(8px)';
    container.appendChild(el);
    requestAnimationFrame(() => { el.style.opacity = '1'; el.style.transform = 'translateY(0)'; });
    setTimeout(() => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(8px)';
      setTimeout(() => el.remove(), 300);
    }, 3000);
  }

  // ─── Modal de confirmação ──────────────────────────────────────────────────
  const confirmModal = document.getElementById('confirm-modal');
  const confirmTitle = document.getElementById('confirm-title');
  const confirmMsg   = document.getElementById('confirm-message');
  const confirmOk    = document.getElementById('confirm-ok');
  const confirmCancel= document.getElementById('confirm-cancel');
  let confirmResolve = null;

  function showConfirm(opts) {
    if (!confirmModal) return Promise.resolve(false);
    confirmTitle.textContent = opts.title ?? 'Confirmar?';
    confirmMsg.textContent   = opts.message ?? '';
    confirmOk.textContent    = opts.okLabel ?? 'Confirmar';
    confirmOk.className = `px-4 py-2 rounded text-sm font-bold text-white ${opts.danger === false ? 'bg-teal hover:bg-teal-hover' : 'bg-red-600 hover:bg-red-700'} transition-colors`;
    confirmModal.classList.remove('hidden');
    return new Promise((resolve) => { confirmResolve = resolve; });
  }
  function closeConfirm(result) {
    confirmModal?.classList.add('hidden');
    if (confirmResolve) { confirmResolve(result); confirmResolve = null; }
  }
  confirmOk?.addEventListener('click',     () => closeConfirm(true));
  confirmCancel?.addEventListener('click', () => closeConfirm(false));
  confirmModal?.addEventListener('click',  (e) => { if (e.target === confirmModal) closeConfirm(false); });

  // ─── Atualização local sem reload ───────────────────────────────────────────
  function updateApptCardStatus(id, newStatus) {
    // Atualiza o cache local primeiro (receita e modal usam isso)
    const appt = clientData.appts.find(a => String(a.id) === String(id));
    if (appt) appt.status = newStatus;

    // Atualiza a linha na lista (AgendaLista) sem precisar recarregar
    const row = document.querySelector(`[data-list-appt="${id}"]`);
    if (row) {
      row.classList.add('opacity-70');
      const nameEl = row.querySelector('.min-w-0 > p:first-child');
      if (nameEl) {
        nameEl.classList.remove('text-neutral-100');
        nameEl.classList.add('text-neutral-500', 'line-through', 'decoration-1');
      }
      const priceEl = row.querySelector('.text-right > p:first-child');
      if (priceEl) {
        priceEl.classList.remove('text-teal-light');
        priceEl.classList.add('text-neutral-600');
      }
      const badge = row.querySelector('[data-list-status]');
      if (badge) {
        if (newStatus === 'completed')      { badge.textContent = '✓ Concluído'; badge.className = 'text-[10px] tabular-nums text-teal-light/80'; }
        else if (newStatus === 'cancelled') { badge.textContent = '✕ Cancelado'; badge.className = 'text-[10px] tabular-nums text-red-400/80'; }
        else if (newStatus === 'no_show')   { badge.textContent = '✗ No-show';   badge.className = 'text-[10px] tabular-nums text-amber-400/80'; }
      }
    }

    recalculateRevenue();
  }

  function recalculateRevenue() {
    let total = 0;
    let count = 0;
    for (const a of clientData.appts) {
      if (a.status === 'confirmed' || a.status === 'completed') {
        total += a.priceCents || 0;
        count++;
      }
    }
    const rev = document.querySelector('section [class*="text-teal-light"][class*="text-3xl"]');
    if (rev) rev.textContent = `R$ ${(total / 100).toFixed(0)}`;
    const countEl = document.querySelector('section .text-xs.text-neutral-500.mt-0\\.5');
    if (countEl) countEl.textContent = `${count} ${count === 1 ? 'agendamento' : 'agendamentos'} considerados (confirmados + concluídos)`;
  }

  // ─── Action buttons ─────────────────────────────────────────────────────────
  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('[data-action]');
    if (!btn) return;
    if (btn.hasAttribute('data-no-card-click')) return;

    const action = btn.dataset.action;
    const id     = btn.dataset.id;
    if (!id) return;

    if (action === 'open-detail') {
      e.preventDefault();
      e.stopPropagation();
      openDetailModal(id);
      return;
    }

    if (action === 'wa-menu') {
      e.preventDefault();
      e.stopPropagation();
      openWaMenu(id);
      return;
    }

    if (action === 'complete') {
      e.preventDefault();
      e.stopPropagation();
      openComanda(id);
      return;
    }

    if (action === 'no-show') {
      btn.disabled = true;
      const { ok, data } = await callApi(`/api/admin/appointments/${id}/no-show`);
      if (ok) {
        updateApptCardStatus(id, 'no_show');
        closeDetail();
        toast('Marcado como no-show', 'success');
      } else {
        toast(data.error ?? 'Erro', 'error');
        btn.disabled = false;
      }

    } else if (action === 'cancel') {
      const confirmed = await showConfirm({
        title:   'Cancelar agendamento?',
        message: 'O cliente será notificado se acessar o link novamente. Esta ação não pode ser desfeita.',
        okLabel: 'Sim, cancelar',
      });
      if (!confirmed) return;
      btn.disabled = true;
      const { ok, data } = await callApi(`/api/admin/appointments/${id}/cancel`);
      if (ok) {
        updateApptCardStatus(id, 'cancelled');
        closeDetail();
        toast('Agendamento cancelado', 'success');
      } else {
        toast(data.error ?? 'Erro', 'error');
        btn.disabled = false;
      }
    }
  });

  // ─── Modal de mensagens rápidas WhatsApp ───────────────────────────────────
  const waModal = document.getElementById('wa-modal');
  const waSub   = document.getElementById('wa-sub');
  const waClose = document.getElementById('wa-close');
  const waOptLembrete = document.getElementById('wa-opt-lembrete');
  const waOptAtrasoCliente = document.getElementById('wa-opt-atraso-cliente');
  const waOptAtrasoBarbeiro = document.getElementById('wa-opt-atraso-barbeiro');
  const waOptLivre = document.getElementById('wa-opt-livre');

  function diaLabel() {
    return clientData.date === clientData.todayStr
      ? 'hoje'
      : `dia ${clientData.date.split('-').reverse().slice(0, 2).join('/')}`;
  }

  function openWaMenu(id) {
    const appt = clientData.appts.find(a => String(a.id) === String(id));
    if (!appt) return;
    if (!appt.wa) {
      toast('Telefone inválido — corrija nos detalhes do agendamento', 'error');
      return;
    }
    const msgs = buildWaMessages(appt.customerName, appt.timeLocal, diaLabel());
    waSub.textContent = `${appt.customerName} · ${appt.timeLocal} · ${appt.customerPhoneDisplay}`;
    waOptLembrete.href        = waLink(appt.wa, msgs.lembrete);
    waOptAtrasoCliente.href   = waLink(appt.wa, msgs.clienteAtrasado);
    waOptAtrasoBarbeiro.href  = waLink(appt.wa, msgs.barbeiroAtrasado);
    waOptLivre.href           = waLink(appt.wa);
    waOptLembrete.querySelector('[data-wa-preview]').textContent       = msgs.lembrete;
    waOptAtrasoCliente.querySelector('[data-wa-preview]').textContent  = msgs.clienteAtrasado;
    waOptAtrasoBarbeiro.querySelector('[data-wa-preview]').textContent = msgs.barbeiroAtrasado;
    waModal.classList.remove('hidden');
  }
  function closeWaMenu() { waModal?.classList.add('hidden'); }
  waClose?.addEventListener('click', closeWaMenu);
  waModal?.addEventListener('click', (e) => { if (e.target === waModal) closeWaMenu(); });
  // Fecha o menu depois de abrir o WhatsApp
  [waOptLembrete, waOptAtrasoCliente, waOptAtrasoBarbeiro, waOptLivre].forEach(a => {
    a?.addEventListener('click', () => setTimeout(closeWaMenu, 150));
  });

  // ─── Modal de detalhes ─────────────────────────────────────────────────────
  const detailModal = document.getElementById('detail-modal');
  const dmName      = document.getElementById('dm-name');
  const dmService   = document.getElementById('dm-service');
  const dmTime      = document.getElementById('dm-time');
  const dmDuration  = document.getElementById('dm-duration');
  const dmPrice     = document.getElementById('dm-price');
  const dmTel       = document.getElementById('dm-tel');
  const dmPhone     = document.getElementById('dm-phone');
  const dmWhats     = document.getElementById('dm-whatsapp');
  const dmCopyPhone = document.getElementById('dm-copy-phone');
  const dmNotes     = document.getElementById('dm-notes');
  const dmNotesSave = document.getElementById('dm-notes-save');
  const dmNotesStatus = document.getElementById('dm-notes-status');
  const dmClose     = document.getElementById('dm-close');
  const dmComplete  = document.getElementById('dm-complete');
  const dmNoshow    = document.getElementById('dm-noshow');
  const dmCancel    = document.getElementById('dm-cancel');
  const dmMoveDate  = document.getElementById('dm-move-date');
  const dmMoveSlots = document.getElementById('dm-move-slots');
  const dmMoveConfirm = document.getElementById('dm-move-confirm');
  const dmHistory      = document.getElementById('dm-history');
  const dmHistoryCount = document.getElementById('dm-history-count');
  const dmStats        = document.getElementById('dm-stats');
  const dmBirthday     = document.getElementById('dm-birthday');
  const dmEditName     = document.getElementById('dm-edit-name');
  const dmEditPhone    = document.getElementById('dm-edit-phone');
  const dmEditBirthdate= document.getElementById('dm-edit-birthdate');
  const dmEditSave     = document.getElementById('dm-edit-save');
  const dmEditStatus   = document.getElementById('dm-edit-status');

  let currentApptId = null;
  let currentMoveSlot = null;
  let notesOriginal = '';
  let editOriginal = { name: '', phone: '', birthdate: '' };

  // Estado visual do botão WhatsApp do modal conforme validade do telefone
  function setWaButtonState(btn, wa) {
    if (!btn) return;
    btn.classList.toggle('opacity-40', !wa);
    btn.title = wa ? 'Mensagens rápidas no WhatsApp' : 'Telefone inválido — corrija abaixo';
  }

  // Máscara de telefone (DDD + número)
  function maskPhone(raw) {
    const d = (raw ?? '').replace(/\D/g, '').slice(0, 11);
    if (d.length === 0) return '';
    if (d.length <= 2)  return `(${d}`;
    if (d.length <= 6)  return `(${d.slice(0, 2)}) ${d.slice(2)}`;
    if (d.length <= 10) return `(${d.slice(0, 2)}) ${d.slice(2, 6)}-${d.slice(6)}`;
    return `(${d.slice(0, 2)}) ${d.slice(2, 7)}-${d.slice(7)}`;
  }
  // Máscara dd/mm/aaaa
  function maskBirthdate(raw) {
    const d = (raw ?? '').replace(/\D/g, '').slice(0, 8);
    if (d.length === 0) return '';
    if (d.length <= 2)  return d;
    if (d.length <= 4)  return `${d.slice(0, 2)}/${d.slice(2)}`;
    return `${d.slice(0, 2)}/${d.slice(2, 4)}/${d.slice(4)}`;
  }
  // Converte 'dd/mm/aaaa' -> 'YYYY-MM-DD' ou null se inválido
  function parseBirthdateInput(raw) {
    const m = (raw ?? '').match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
    if (!m) return null;
    const dd = +m[1], mm = +m[2], yyyy = +m[3];
    if (mm < 1 || mm > 12 || dd < 1 || dd > 31) return null;
    const dt = new Date(yyyy, mm - 1, dd);
    if (dt.getFullYear() !== yyyy || dt.getMonth() !== mm - 1 || dt.getDate() !== dd) return null;
    const now = new Date();
    const min = new Date(now.getFullYear() - 100, now.getMonth(), now.getDate());
    const max = new Date(now.getFullYear() - 5, now.getMonth(), now.getDate());
    if (dt < min || dt > max) return null;
    const pad = n => String(n).padStart(2, '0');
    return `${yyyy}-${pad(mm)}-${pad(dd)}`;
  }
  // Converte 'YYYY-MM-DD' -> 'dd/mm/aaaa'
  function formatBirthdateDisplay(iso) {
    if (!iso || !/^\d{4}-\d{2}-\d{2}$/.test(iso)) return '';
    const [y, m, d] = iso.split('-');
    return `${d}/${m}/${y}`;
  }

  dmEditPhone?.addEventListener('input', () => {
    dmEditPhone.value = maskPhone(dmEditPhone.value);
    checkEditChanged();
  });
  dmEditBirthdate?.addEventListener('input', () => {
    dmEditBirthdate.value = maskBirthdate(dmEditBirthdate.value);
    checkEditChanged();
  });
  dmEditName?.addEventListener('input', checkEditChanged);

  function checkEditChanged() {
    const changed = dmEditName.value !== editOriginal.name
                 || dmEditPhone.value !== editOriginal.phone
                 || dmEditBirthdate.value !== editOriginal.birthdate;
    dmEditSave?.classList.toggle('hidden', !changed);
    if (changed) dmEditStatus.textContent = '';
  }

  // Selo de aniversário no header (compara dia/mês no fuso de Fortaleza).
  function setBirthdayBadge(iso) {
    if (!dmBirthday) return;
    dmBirthday.classList.add('hidden');
    dmBirthday.textContent = '';
    if (!iso || !/^\d{4}-\d{2}-\d{2}$/.test(iso)) return;
    const [, bm, bd] = iso.split('-').map(Number);
    const fortNow = new Date(new Date().toLocaleString('en-US', { timeZone: 'America/Fortaleza' }));
    const tMonth = fortNow.getMonth() + 1, tDay = fortNow.getDate();
    if (bm === tMonth && bd === tDay) {
      dmBirthday.textContent = '🎂 Aniversário hoje!';
      dmBirthday.classList.remove('hidden');
    } else if (bm === tMonth) {
      dmBirthday.textContent = '🎂 Aniversário este mês';
      dmBirthday.classList.remove('hidden');
    }
  }

  // Ficha do cliente: faixa de stats agregados.
  function renderClientStats(stats, total) {
    if (!dmStats) return;
    const brl = (c) => 'R$ ' + Math.round((c || 0) / 100).toLocaleString('pt-BR');

    // Primeira visita: só existe o agendamento atual.
    if (!stats || (total ?? stats.totalCount) <= 1) {
      dmStats.className = '';
      dmStats.innerHTML = '<p class="text-xs text-teal-light bg-teal/10 border border-teal/20 rounded px-3 py-2">✨ Primeira visita deste cliente</p>';
      return;
    }

    const riskColor = stats.noShowRate >= 25 ? 'text-red-400'
                    : stats.noShowRate >= 10 ? 'text-amber-400'
                    : 'text-neutral-200';

    let since = '';
    if (stats.firstVisitAt) {
      const d = new Date(stats.firstVisitAt);
      since = d.toLocaleDateString('pt-BR', { month: 'short', year: '2-digit', timeZone: 'America/Fortaleza' });
    }

    const cell = (label, value, cls = 'text-neutral-200') => `
      <div class="bg-dark-surface border border-white/5 rounded p-2 text-center">
        <p class="text-[9px] text-neutral-500 uppercase tracking-wider">${label}</p>
        <p class="text-sm font-bold ${cls} tabular-nums mt-0.5">${value}</p>
      </div>`;

    dmStats.className = '';
    dmStats.innerHTML = `
      <div class="grid grid-cols-3 gap-2">
        ${cell('Gasto total', brl(stats.totalSpentCents), 'text-teal-light')}
        ${cell('Visitas', String(stats.completedCount))}
        ${cell('Faltas', `${stats.noShowCount}${stats.noShowRate ? ` · ${stats.noShowRate}%` : ''}`, riskColor)}
      </div>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-2 text-[11px] text-neutral-500">
        ${stats.favoriteService ? `<span>Favorito: <span class="text-neutral-300">${stats.favoriteService}</span></span>` : ''}
        ${since ? `<span>Cliente desde <span class="text-neutral-300">${since}</span></span>` : ''}
      </div>`;
  }

  async function loadHistory(id) {
    if (!dmHistory) return;
    dmHistory.innerHTML = '<p class="text-neutral-600 italic">Carregando...</p>';
    if (dmHistoryCount) dmHistoryCount.textContent = '';
    try {
      const res = await fetch(`/api/admin/appointments/${id}/history?limit=5`);
      const data = await res.json();
      if (!res.ok) {
        dmHistory.innerHTML = '<p class="text-red-400">Erro ao carregar histórico</p>';
        if (dmStats) { dmStats.className = 'text-xs text-neutral-600 italic'; dmStats.textContent = ''; }
        return;
      }
      renderClientStats(data.stats, data.total);
      if (!data.history?.length) {
        dmHistory.innerHTML = '<p class="text-neutral-600">Primeira visita deste cliente.</p>';
        if (dmHistoryCount) dmHistoryCount.textContent = '1 total';
        return;
      }
      if (dmHistoryCount) dmHistoryCount.textContent = `${data.total} no total`;
      dmHistory.innerHTML = data.history.map(h => {
        const d = new Date(h.startsAt);
        const dateLabel = d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: '2-digit' });
        const timeLabel = d.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit', timeZone: 'America/Fortaleza' });
        const price = `R$ ${(h.priceCents / 100).toFixed(0)}`;
        const statusColor = h.status === 'completed' ? 'text-teal-light'
                         : h.status === 'cancelled' ? 'text-red-400/70'
                         : h.status === 'no_show'   ? 'text-amber-400/80'
                         :                            'text-neutral-300';
        const statusIcon = h.status === 'completed' ? '✓'
                        : h.status === 'cancelled' ? '✕'
                        : h.status === 'no_show'   ? '✗'
                        :                            '•';
        return `
          <div class="flex items-center gap-2 py-1.5 px-2 bg-dark-surface/50 rounded border border-white/5">
            <span class="${statusColor} text-xs w-3 text-center">${statusIcon}</span>
            <div class="flex-1 min-w-0">
              <p class="text-neutral-300 truncate">${h.serviceName} <span class="text-neutral-600">· ${h.barberName.split(' ')[0]}</span></p>
              <p class="text-neutral-600 text-[10px] tabular-nums">${dateLabel} · ${timeLabel}</p>
            </div>
            <span class="text-neutral-500 text-[11px] tabular-nums shrink-0">${price}</span>
          </div>
        `;
      }).join('');
    } catch {
      dmHistory.innerHTML = '<p class="text-red-400">Erro ao carregar histórico</p>';
    }
  }

  dmEditSave?.addEventListener('click', async () => {
    if (!currentApptId) return;
    const name = dmEditName.value.trim();
    const phoneDigits = dmEditPhone.value.replace(/\D/g, '');
    const birthdateIso = dmEditBirthdate.value.trim() === ''
      ? null
      : parseBirthdateInput(dmEditBirthdate.value);

    if (name.length < 2)         { dmEditStatus.textContent = 'Nome muito curto'; dmEditStatus.className = 'text-[10px] text-red-400'; return; }
    if (phoneDigits.length < 10) { dmEditStatus.textContent = 'Telefone inválido'; dmEditStatus.className = 'text-[10px] text-red-400'; return; }
    if (dmEditBirthdate.value.trim() !== '' && !birthdateIso) {
      dmEditStatus.textContent = 'Data inválida'; dmEditStatus.className = 'text-[10px] text-red-400'; return;
    }

    dmEditStatus.textContent = '';
    dmEditSave.disabled = true;
    dmEditSave.textContent = 'Salvando...';

    const { ok, data } = await callApi(`/api/admin/appointments/${currentApptId}/customer`, 'PATCH', {
      customerName:      name,
      customerPhone:     dmEditPhone.value,
      customerBirthdate: birthdateIso,
    });

    dmEditSave.disabled = false;
    dmEditSave.textContent = 'Salvar';
    if (ok) {
      editOriginal = { name: dmEditName.value, phone: dmEditPhone.value, birthdate: dmEditBirthdate.value };
      dmEditSave.classList.add('hidden');
      dmEditStatus.className = 'text-[10px] text-teal-light';
      dmEditStatus.textContent = data.propagated
        ? `Atualizado em ${data.updated} agendamento${data.updated > 1 ? 's' : ''}`
        : 'Atualizado';
      // Atualiza o appt no cache local + header do modal
      const appt = clientData.appts.find(a => String(a.id) === String(currentApptId));
      if (appt) {
        appt.customerName  = name;
        appt.customerPhone = dmEditPhone.value;
        appt.customerPhoneDisplay = maskPhone(dmEditPhone.value);
        // Recalcula telefone normalizado (wa.me) e tel:
        appt.wa = waPhone(phoneDigits);
        appt.telUrl = `tel:+${appt.wa ?? (phoneDigits.startsWith('55') ? phoneDigits : `55${phoneDigits}`)}`;
      }
      dmName.textContent  = name;
      dmPhone.textContent = maskPhone(dmEditPhone.value);
      dmTel.href = appt?.telUrl ?? '#';
      setWaButtonState(dmWhats, appt?.wa);
      // Atualiza data attrs do card na timeline
      const card = document.getElementById(`appt-${currentApptId}`);
      if (card) {
        card.dataset.customerName = name;
        card.dataset.phoneDisplay = maskPhone(dmEditPhone.value);
        const nameEl = card.querySelector('.flex.items-baseline span.text-sm.font-medium, .flex.items-baseline span:nth-child(2)');
        if (nameEl) nameEl.textContent = name;
      }
      toast('Cliente atualizado', 'success');
    } else {
      dmEditStatus.className = 'text-[10px] text-red-400';
      dmEditStatus.textContent = data.error ?? 'Erro';
    }
  });

  function openDetailModal(id) {
    const appt = clientData.appts.find(a => String(a.id) === String(id));
    if (!appt) return;
    currentApptId = id;
    currentMoveSlot = null;

    dmName.textContent     = appt.customerName;
    dmService.textContent  = `${appt.serviceName} · ${appt.barberName} · ${appt.price}`;
    dmTime.textContent     = `${appt.timeLocal} → ${appt.endTimeLocal}`;
    dmDuration.textContent = `${appt.durationMinutes}min`;
    dmPrice.textContent    = appt.price;
    dmPhone.textContent    = appt.customerPhoneDisplay || '—';
    dmTel.href             = appt.telUrl;
    dmWhats.dataset.id     = String(appt.id);
    setWaButtonState(dmWhats, appt.wa);
    dmNotes.value          = appt.notes ?? '';
    notesOriginal          = dmNotes.value;
    dmNotesStatus.textContent = '';
    dmNotesSave.classList.add('hidden');

    // Edição de cliente
    dmEditName.value      = appt.customerName;
    dmEditPhone.value     = appt.customerPhoneDisplay;
    dmEditBirthdate.value = formatBirthdateDisplay(appt.customerBirthdate);
    editOriginal = { name: dmEditName.value, phone: dmEditPhone.value, birthdate: dmEditBirthdate.value };
    dmEditSave.classList.add('hidden');
    dmEditStatus.textContent = '';

    // Ficha do cliente: reseta, marca aniversário e carrega stats + histórico
    if (dmStats) { dmStats.className = 'text-xs text-neutral-600 italic'; dmStats.textContent = 'Carregando…'; }
    setBirthdayBadge(appt.customerBirthdate);
    loadHistory(id);

    // Auditoria
    const auditEl = document.getElementById('dm-audit');
    const auditText = document.getElementById('dm-audit-text');
    if (appt.lastModifiedLabel) {
      auditEl?.classList.remove('hidden');
      if (auditText) auditText.textContent = appt.lastModifiedLabel;
    } else {
      auditEl?.classList.add('hidden');
    }

    [dmComplete, dmNoshow, dmCancel].forEach(b => b.dataset.id = id);

    // Mover horário: data atual default
    dmMoveDate.value = clientData.date;
    dmMoveDate.min = clientData.todayStr;
    dmMoveSlots.innerHTML = '<span class="text-neutral-500">Selecione uma data acima.</span>';
    dmMoveConfirm.disabled = true;

    // Bloquear ações se status != confirmed
    const isConfirmed = appt.status === 'confirmed';
    [dmComplete, dmNoshow, dmCancel].forEach(b => {
      b.disabled = !isConfirmed;
      b.classList.toggle('opacity-40', !isConfirmed);
      b.classList.toggle('cursor-not-allowed', !isConfirmed);
    });
    dmMoveDate.disabled = !isConfirmed;
    dmMoveConfirm.disabled = true;
    if (isConfirmed) loadMoveSlots();

    detailModal.classList.remove('hidden');
  }

  function closeDetail() {
    detailModal?.classList.add('hidden');
    currentApptId = null;
  }
  dmClose?.addEventListener('click', closeDetail);
  detailModal?.addEventListener('click', (e) => { if (e.target === detailModal) closeDetail(); });

  // Copiar telefone
  dmCopyPhone?.addEventListener('click', async () => {
    const text = dmPhone?.textContent?.trim();
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
      toast('Telefone copiado', 'success');
    } catch {
      toast('Não foi possível copiar', 'error');
    }
  });

  // Notas: mostra "salvar" se mudou
  dmNotes?.addEventListener('input', () => {
    const changed = dmNotes.value !== notesOriginal;
    dmNotesSave?.classList.toggle('hidden', !changed);
    if (changed) dmNotesStatus.textContent = '';
  });
  dmNotesSave?.addEventListener('click', async () => {
    if (!currentApptId) return;
    dmNotesSave.textContent = 'Salvando...';
    dmNotesSave.disabled = true;
    const { ok, data } = await callApi(`/api/admin/appointments/${currentApptId}/notes`, 'PATCH', {
      notes: dmNotes.value,
    });
    dmNotesSave.disabled = false;
    dmNotesSave.textContent = 'Salvar notas';
    if (ok) {
      notesOriginal = dmNotes.value;
      dmNotesSave.classList.add('hidden');
      dmNotesStatus.textContent = 'Notas salvas';
      const appt = clientData.appts.find(a => String(a.id) === String(currentApptId));
      if (appt) appt.notes = data.notes;
    } else {
      toast(data.error ?? 'Erro ao salvar notas', 'error');
    }
  });

  // Reagendar: carrega slots ao mudar data
  async function loadMoveSlots() {
    if (!currentApptId) return;
    const appt = clientData.appts.find(a => String(a.id) === String(currentApptId));
    if (!appt) return;
    const targetDate = dmMoveDate.value;
    if (!targetDate) return;
    dmMoveSlots.innerHTML = '<span class="text-neutral-500">Carregando horários...</span>';
    dmMoveConfirm.disabled = true;
    currentMoveSlot = null;

    try {
      const params = new URLSearchParams({
        barberId: String(appt.barberId),
        serviceId: '0', // não usa serviceId aqui, mas API exige; vou só pedir o slots por barberId
        date: targetDate,
      });
      // /api/slots espera serviceId pra calcular duração. Como vamos manter o serviço,
      // usamos a duração do próprio appt: adicionamos excludeAppointmentId pra liberar o slot atual.
      params.set('excludeAppointmentId', String(appt.id));

      // Sem serviceId fácil — pedir slots pra cada serviço seria lento. Vamos usar uma alternativa:
      // gerar slots por step de 15min entre 08:00 e 19:00, sem chamar a API.
      // (A API de reschedule revalida no servidor.)
      dmMoveSlots.innerHTML = '';
      const grid = document.createElement('div');
      grid.className = 'grid grid-cols-4 gap-1.5 max-h-48 overflow-y-auto';

      const STEP = 15; // 15 minutos entre slots
      const startMin = clientData.startHour * 60;
      const endMin   = (clientData.startHour + 11) * 60; // 08:00-19:00
      const duration = appt.durationMinutes;

      for (let m = startMin; m + duration <= endMin; m += STEP) {
        const h = Math.floor(m / 60);
        const mm = m % 60;
        const label = `${String(h).padStart(2,'0')}:${String(mm).padStart(2,'0')}`;
        // utc: targetDate local + h:mm → UTC adicionando 3h (Fortaleza UTC-3)
        const [y, mo, d] = targetDate.split('-').map(Number);
        const utc = new Date(Date.UTC(y, mo - 1, d, h + 3, mm)).toISOString();

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = label;
        btn.dataset.iso = utc;
        btn.className = 'text-xs px-2 py-1.5 border border-white/10 rounded text-neutral-300 hover:border-teal/40 hover:text-teal-light transition-colors tabular-nums';
        // Marca o atual desabilitado
        if (utc === '' /* impossivel */) {/* placeholder */}
        btn.addEventListener('click', () => {
          grid.querySelectorAll('button').forEach(b =>
            b.classList.remove('bg-teal/20', 'border-teal/50', 'text-teal-light'));
          btn.classList.add('bg-teal/20', 'border-teal/50', 'text-teal-light');
          currentMoveSlot = utc;
          dmMoveConfirm.disabled = false;
        });
        grid.appendChild(btn);
      }
      dmMoveSlots.appendChild(grid);
    } catch {
      dmMoveSlots.innerHTML = '<span class="text-red-400">Erro ao carregar.</span>';
    }
  }
  dmMoveDate?.addEventListener('change', loadMoveSlots);

  dmMoveConfirm?.addEventListener('click', async () => {
    if (!currentApptId || !currentMoveSlot) return;
    dmMoveConfirm.disabled = true;
    dmMoveConfirm.textContent = 'Reagendando...';
    const { ok, data } = await callApi(`/api/admin/appointments/${currentApptId}/reschedule`, 'POST', {
      startsAt: currentMoveSlot,
    });
    dmMoveConfirm.textContent = 'Confirmar reagendamento';
    if (ok) {
      toast('Reagendado com sucesso. Recarregando...', 'success');
      setTimeout(() => location.reload(), 800); // Reload pra reposicionar card na timeline
    } else {
      toast(data.error ?? 'Erro ao reagendar', 'error');
      dmMoveConfirm.disabled = false;
    }
  });

  // ESC fecha modais
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (!detailModal?.classList.contains('hidden')) closeDetail();
      if (!confirmModal?.classList.contains('hidden')) closeConfirm(false);
    }
  });

  // ─── Buraco clicável pra agendar ──────────────────────────────────────────
  const emptyArea = document.getElementById('empty-click-area');
  function readHourPx() {
    const root = document.querySelector('.timeline-root');
    if (!root) return 110;
    const val = getComputedStyle(root).getPropertyValue('--hour-px').trim();
    const n = parseFloat(val);
    return isFinite(n) && n > 0 ? n : 110;
  }
  emptyArea?.addEventListener('click', (e) => {
    if (e.target !== emptyArea) return;
    const rect = emptyArea.getBoundingClientRect();
    const offsetY = e.clientY - rect.top;
    const hourPx = readHourPx();
    const minutesFromStart = Math.floor((offsetY / hourPx) * 60);
    const snapped = Math.floor(minutesFromStart / 15) * 15;
    const totalH = clientData.startHour * 60 + snapped;
    const h = Math.floor(totalH / 60);
    const mm = totalH % 60;
    const timeStr = `${String(h).padStart(2,'0')}:${String(mm).padStart(2,'0')}`;

    openExpressMenu(timeStr);
  });

  // ─── Menu de ação rápida (agendar / bloqueio expresso) ──────────────────────
  const exModal   = document.getElementById('express-modal');
  const exTimeEl  = document.getElementById('ex-time');
  const exHint    = document.getElementById('ex-hint');
  const exAgendar = document.getElementById('ex-agendar');
  const exBlock30 = document.getElementById('ex-block-30');
  const exBlock60 = document.getElementById('ex-block-60');
  let exTimeStr = null;

  // Barbeiro alvo do bloqueio expresso: o próprio (barber) ou o filtrado (admin)
  function expressBarberId() {
    return role === 'admin' ? filterBarberId : sessionBarberId;
  }

  function openExpressMenu(timeStr) {
    exTimeStr = timeStr;
    if (exTimeEl) exTimeEl.textContent = timeStr;
    const canBlock = !!expressBarberId();
    [exBlock30, exBlock60].forEach(b => { if (b) b.disabled = !canBlock; });
    exHint?.classList.toggle('hidden', canBlock);
    exModal?.classList.remove('hidden');
  }
  function closeExpressMenu() { exModal?.classList.add('hidden'); }
  document.getElementById('ex-close')?.addEventListener('click', closeExpressMenu);
  exModal?.addEventListener('click', (e) => { if (e.target === exModal) closeExpressMenu(); });

  exAgendar?.addEventListener('click', () => {
    closeExpressMenu();
    formBlock?.classList.add('hidden');
    formManual?.classList.remove('hidden');
    loadServices();
    // Encaixe rápido: pré-seleciona o barbeiro quando já se sabe quem é
    // (admin com filtro ativo; barbeiro comum nem tem o select)
    const mBarber = document.getElementById('m-barber');
    if (mBarber && role === 'admin' && filterBarberId) {
      mBarber.value = String(filterBarberId);
    }
    formManual?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    // Guarda preferência de horário pra pré-selecionar quando os slots carregarem
    window.__preferredSlotTime = exTimeStr;
    document.getElementById('m-service')?.focus();
    toast(`Escolha o serviço para encaixar às ${exTimeStr}`, 'info');
  });

  async function expressBlock(minutes, btn) {
    const barberId = expressBarberId();
    if (!barberId || !exTimeStr) return;
    btn.disabled = true;
    const startsAt = localTimeToUtcIso(date, exTimeStr);
    const endsAt   = new Date(new Date(startsAt).getTime() + minutes * 60_000).toISOString();
    const { ok, data } = await callApi('/api/admin/time-off', 'POST', {
      barberId,
      startsAt,
      endsAt,
      reason: 'Bloqueio rápido',
    });
    if (ok) {
      location.reload();
      return;
    }
    btn.disabled = false;
    closeExpressMenu();
    if (data.conflicts?.length) {
      const lista = data.conflicts.map(c => `${c.timeLocal} — ${c.customerName}`).join(', ');
      await showConfirm({
        title:   'Já tem cliente nesse intervalo',
        message: `${lista}. Cancele ou mova o agendamento antes de bloquear.`,
        okLabel: 'Entendi',
        danger:  false,
      });
    } else {
      toast(data.error ?? 'Erro ao bloquear', 'error');
    }
  }
  exBlock30?.addEventListener('click', () => expressBlock(30, exBlock30));
  exBlock60?.addEventListener('click', () => expressBlock(60, exBlock60));

  // ─── Toggle forms ────────────────────────────────────────────────────────────
  const formManual = document.getElementById('form-manual');
  const formBlock  = document.getElementById('form-block');

  document.getElementById('btn-manual')?.addEventListener('click', () => {
    formBlock?.classList.add('hidden');
    formManual?.classList.toggle('hidden');
    if (!formManual?.classList.contains('hidden')) {
      loadServices();
      formManual?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  });

  document.getElementById('btn-block')?.addEventListener('click', () => {
    formManual?.classList.add('hidden');
    formBlock?.classList.toggle('hidden');
    if (!formBlock?.classList.contains('hidden')) {
      formBlock?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  });

  document.getElementById('close-manual')?.addEventListener('click', () => formManual?.classList.add('hidden'));
  document.getElementById('close-block')?.addEventListener('click',  () => formBlock?.classList.add('hidden'));

  // Botões do estado vazio reaproveitam os toggles da barra inferior
  document.querySelector('[data-empty-manual]')?.addEventListener('click', () => document.getElementById('btn-manual')?.click());
  document.querySelector('[data-empty-block]')?.addEventListener('click',  () => document.getElementById('btn-block')?.click());

  // ─── Comanda: fechar atendimento com serviços extras ─────────────────────────
  const comandaModal = document.getElementById('comanda-modal');
  let comandaApptId: string | null = null;
  let comandaExtras: { serviceId: number; name: string; priceCents: number }[] = [];
  let servicesCatalog: any[] | null = null;

  async function ensureServicesCatalog() {
    if (servicesCatalog) return servicesCatalog;
    try {
      const res = await fetch('/api/services');
      servicesCatalog = res.ok ? await res.json() : [];
    } catch { servicesCatalog = []; }
    return servicesCatalog;
  }

  function renderComanda() {
    const appt = clientData.appts.find(a => String(a.id) === String(comandaApptId));
    const mainCents = appt ? appt.priceCents : 0;
    const list = document.getElementById('cm-extras');
    if (list) {
      list.innerHTML = '';
      comandaExtras.forEach((ex, i) => {
        const row = document.createElement('div');
        row.className = 'flex items-center justify-between gap-2 text-sm bg-dark-surface rounded px-3 py-2';
        row.innerHTML = `<span class="text-neutral-300">${ex.name}</span><span class="flex items-center gap-3"><span class="text-neutral-400 tabular-nums">R$ ${Math.round(ex.priceCents / 100)}</span><button type="button" data-cm-remove="${i}" class="text-red-400/70 hover:text-red-400" aria-label="Remover">✕</button></span>`;
        list.appendChild(row);
      });
    }
    const total = mainCents + comandaExtras.reduce((s, e) => s + e.priceCents, 0);
    const totalEl = document.getElementById('cm-total');
    if (totalEl) totalEl.textContent = 'R$ ' + Math.round(total / 100);
  }

  async function openComanda(id: string) {
    const appt = clientData.appts.find(a => String(a.id) === String(id));
    if (!appt) return;
    comandaApptId = id;
    comandaExtras = [];

    const apptEl  = document.getElementById('cm-appt');
    const nameEl  = document.getElementById('cm-main-name');
    const priceEl = document.getElementById('cm-main-price');
    if (apptEl)  apptEl.textContent  = `${appt.customerName} · ${appt.timeLocal}`;
    if (nameEl)  nameEl.textContent  = appt.serviceName;
    if (priceEl) priceEl.textContent = appt.price;

    const select = document.getElementById('cm-extra-select') as HTMLSelectElement | null;
    const catalog = await ensureServicesCatalog();
    if (select && select.options.length <= 1) {
      catalog.forEach((svc: any) => {
        const opt = document.createElement('option');
        opt.value = String(svc.id);
        opt.dataset.name  = svc.name;
        opt.dataset.cents = String(svc.priceCents);
        opt.textContent   = `${svc.name} — R$ ${Math.round(svc.priceCents / 100)}`;
        select.appendChild(opt);
      });
    }
    renderComanda();
    comandaModal?.classList.remove('hidden');
  }

  function closeComanda() {
    comandaModal?.classList.add('hidden');
    comandaApptId = null;
    comandaExtras = [];
  }

  document.getElementById('cm-extra-add')?.addEventListener('click', () => {
    const select = document.getElementById('cm-extra-select') as HTMLSelectElement | null;
    if (!select || !select.value) return;
    const opt = select.options[select.selectedIndex];
    comandaExtras.push({
      serviceId:  Number(select.value),
      name:       opt.dataset.name ?? 'Serviço',
      priceCents: Number(opt.dataset.cents ?? '0'),
    });
    select.value = '';
    renderComanda();
  });

  document.getElementById('cm-extras')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-cm-remove]');
    if (!btn) return;
    comandaExtras.splice(Number(btn.dataset.cmRemove), 1);
    renderComanda();
  });

  document.getElementById('cm-cancel')?.addEventListener('click', closeComanda);
  document.getElementById('cm-close')?.addEventListener('click', closeComanda);
  comandaModal?.addEventListener('click', (e) => { if (e.target === comandaModal) closeComanda(); });

  document.getElementById('cm-confirm')?.addEventListener('click', async () => {
    if (comandaApptId == null) return;
    const id = comandaApptId;
    const btn = document.getElementById('cm-confirm') as HTMLButtonElement | null;
    if (btn) { btn.disabled = true; btn.textContent = '...'; }
    const extras = comandaExtras.map(e => ({ serviceId: e.serviceId, priceCents: e.priceCents }));
    const { ok, data } = await callApi(`/api/admin/appointments/${id}/complete`, 'POST', { extras });
    if (ok) {
      updateApptCardStatus(id, 'completed');
      closeComanda();
      closeDetail();
      toast(extras.length ? 'Atendimento fechado' : 'Marcado como concluído', 'success');
    } else {
      toast(data.error ?? 'Erro', 'error');
    }
    if (btn) { btn.disabled = false; btn.textContent = 'Concluir e fechar'; }
  });


  // ─── Manual booking form ─────────────────────────────────────────────────────
  let selectedSlot = null;

  async function loadServices() {
    const serviceEl = document.getElementById('m-service');
    if (!serviceEl || serviceEl.options.length > 1) return;
    const res  = await fetch('/api/services');
    const data = await res.json();
    data.forEach(svc => {
      const opt = document.createElement('option');
      opt.value       = String(svc.id);
      opt.textContent = svc.name;
      serviceEl.appendChild(opt);
    });
  }

  async function loadSlots() {
    const slotsWrap = document.getElementById('m-slots-wrap');
    if (!slotsWrap) return;

    const barberId  = role === 'admin'
      ? document.getElementById('m-barber')?.value
      : String(sessionBarberId);
    const serviceId = document.getElementById('m-service')?.value;

    if (!barberId || !serviceId) {
      slotsWrap.innerHTML = '<span class="text-neutral-500">Selecione barbeiro e serviço primeiro.</span>';
      selectedSlot = null;
      return;
    }

    slotsWrap.innerHTML = '<span class="text-neutral-500">Carregando...</span>';
    selectedSlot = null;

    try {
      const res  = await fetch(`/api/slots?barberId=${barberId}&serviceId=${serviceId}&date=${date}`);
      const data = await res.json();

      if (!data.slots?.length) {
        slotsWrap.innerHTML = '<span class="text-neutral-500">Nenhum horário disponível.</span>';
        return;
      }

      slotsWrap.innerHTML = '';
      const grid = document.createElement('div');
      grid.className = 'flex flex-wrap gap-2';
      const preferred = window.__preferredSlotTime;
      let preferredBtn = null;
      // Casa com o slot mais próximo do horário clicado (até 30min de distância).
      // Empate → prefere o slot que vem DEPOIS do clique, não antes.
      const toMin = t => { const [h, m] = t.split(':').map(Number); return h * 60 + m; };
      let bestScore = Infinity;

      data.slots.forEach(slot => {
        const isoStr = typeof slot === 'string' ? slot : slot.utc;
        const label  = typeof slot === 'string'
          ? (() => {
              const [h, min] = new Date(isoStr).toISOString().slice(11, 16).split(':').map(Number);
              const hLocal   = (h - 3 + 24) % 24;
              return `${String(hLocal).padStart(2,'0')}:${String(min).padStart(2,'0')}`;
            })()
          : slot.time;
        const btn = document.createElement('button');
        btn.type        = 'button';
        btn.textContent = label;
        btn.dataset.iso = isoStr;
        btn.dataset.time = label;
        btn.className   = 'text-xs px-3 py-1.5 border border-white/10 rounded text-neutral-400 hover:border-teal/40 hover:text-teal-light transition-colors';
        btn.addEventListener('click', () => {
          slotsWrap.querySelectorAll('button').forEach(b =>
            b.classList.remove('bg-teal/20', 'border-teal/50', 'text-teal-light'));
          btn.classList.add('bg-teal/20', 'border-teal/50', 'text-teal-light');
          selectedSlot = isoStr;
        });
        grid.appendChild(btn);

        if (preferred) {
          const diff = toMin(label) - toMin(preferred);
          if (Math.abs(diff) <= 30) {
            const score = Math.abs(diff) * 2 + (diff >= 0 ? 0 : 1);
            if (score < bestScore) { bestScore = score; preferredBtn = btn; }
          }
        }
      });
      slotsWrap.appendChild(grid);

      // Auto-seleciona horário preferido (vindo de click em buraco)
      if (preferredBtn) {
        preferredBtn.click();
        preferredBtn.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        window.__preferredSlotTime = null;
        // Próximo passo do encaixe: nome do cliente
        document.getElementById('m-name')?.focus();
      }
    } catch {
      slotsWrap.innerHTML = '<span class="text-red-400">Erro ao carregar horários.</span>';
    }
  }

  document.getElementById('m-barber')?.addEventListener('change', loadSlots);
  document.getElementById('m-service')?.addEventListener('change', loadSlots);

  document.getElementById('m-submit')?.addEventListener('click', async () => {
    const errorEl = document.getElementById('m-error');
    const submitBtn = document.getElementById('m-submit');

    const barberId  = role === 'admin'
      ? document.getElementById('m-barber')?.value
      : String(sessionBarberId);
    const serviceId = document.getElementById('m-service')?.value;
    const name      = document.getElementById('m-name')?.value.trim();
    const phone     = document.getElementById('m-phone')?.value.trim();

    const showErr = msg => {
      errorEl.textContent = msg;
      errorEl.classList.remove('hidden');
    };

    errorEl.classList.add('hidden');
    if (!barberId)  return showErr('Selecione um barbeiro');
    if (!serviceId) return showErr('Selecione um serviço');
    if (!selectedSlot) return showErr('Selecione um horário');
    if (!name)      return showErr('Informe o nome do cliente');
    if (!phone)     return showErr('Informe o WhatsApp do cliente');

    submitBtn.disabled    = true;
    submitBtn.textContent = 'Agendando...';

    const { ok, data } = await callApi('/api/admin/appointments', 'POST', {
      barberId:      parseInt(barberId),
      serviceId:     parseInt(serviceId),
      customerName:  name,
      customerPhone: phone,
      startsAt:      selectedSlot,
    });

    if (ok) {
      location.reload();
    } else {
      showErr(data.error ?? 'Erro ao criar agendamento');
      submitBtn.disabled    = false;
      submitBtn.textContent = 'Confirmar agendamento';
    }
  });

  // ─── Block time form ──────────────────────────────────────────────────────────
  document.getElementById('b-submit')?.addEventListener('click', async () => {
    const errorEl  = document.getElementById('b-error');
    const submitBtn = document.getElementById('b-submit');

    const barberId = role === 'admin'
      ? (document.getElementById('b-barber')?.value || null)
      : sessionBarberId;
    const startTime = document.getElementById('b-start')?.value;
    const endTime   = document.getElementById('b-end')?.value;
    const reason    = document.getElementById('b-reason')?.value.trim() || undefined;

    const showErr = msg => {
      errorEl.textContent = msg;
      errorEl.classList.remove('hidden');
    };

    errorEl.classList.add('hidden');
    if (!startTime || !endTime) return showErr('Informe os horários');

    const startsAt = localTimeToUtcIso(date, startTime);
    const endsAt   = localTimeToUtcIso(date, endTime);

    submitBtn.disabled    = true;
    submitBtn.textContent = 'Bloqueando...';

    const { ok, data } = await callApi('/api/admin/time-off', 'POST', {
      barberId: barberId ? parseInt(barberId) : null,
      startsAt,
      endsAt,
      reason,
    });

    if (ok) {
      location.reload();
    } else {
      showErr(data.error ?? 'Erro ao bloquear');
      submitBtn.disabled    = false;
      submitBtn.textContent = 'Bloquear';
    }
  });

  // ─── Scroll auto pra "Agora" se for hoje ──────────────────────────────────────
  // Restaura posição se vier de um auto-refresh
  const restoreScroll = sessionStorage.getItem('dia-scroll-y');
  if (restoreScroll) {
    sessionStorage.removeItem('dia-scroll-y');
    requestAnimationFrame(() => window.scrollTo(0, parseInt(restoreScroll, 10)));
  } else if (date === clientData.todayStr) {
    requestAnimationFrame(() => {
      const tlArea = document.getElementById('timeline-area');
      const now = tlArea?.querySelector('.bg-teal.h-px');
      if (now) {
        const rect = now.getBoundingClientRect();
        window.scrollTo({ top: window.scrollY + rect.top - 200, behavior: 'smooth' });
      }
    });
  } else {
    // Dia passado/futuro: abre já no primeiro agendamento, se houver
    requestAnimationFrame(() => {
      const firstCard = document.querySelector('.appt-card');
      if (firstCard) {
        const rect = firstCard.getBoundingClientRect();
        window.scrollTo({ top: window.scrollY + rect.top - 160, behavior: 'smooth' });
      }
    });
  }

  // ─── Auto-refresh discreto ──────────────────────────────────────────────────
  // A cada 60s verifica se mudou (count ou maxModified). Se sim e nada está
  // em foco, salva scroll e recarrega.
  (function setupAutoRefresh() {
    // Snapshot inicial: conta direto do DOM
    const initialCount = document.querySelectorAll('.appt-card').length;
    let lastKnownCount = initialCount;
    let lastKnownMod   = ''; // primeira chamada já vai popular

    async function poll() {
      // Não checa em outras abas / janela escondida
      if (document.hidden) return;
      // Não recarrega se modal aberto ou form em uso
      if (!detailModal?.classList.contains('hidden')) return;
      if (!confirmModal?.classList.contains('hidden')) return;
      if (!formManual?.classList.contains('hidden')) return;
      if (!formBlock?.classList.contains('hidden')) return;
      // Não recarrega se usuário tá digitando algo
      const ae = document.activeElement;
      if (ae && (ae.tagName === 'INPUT' || ae.tagName === 'TEXTAREA' || ae.tagName === 'SELECT')) return;

      try {
        const params = new URLSearchParams({ date });
        if (filterBarberId) params.set('barber', String(filterBarberId));
        const res = await fetch(`/api/admin/appointments/count?${params}`);
        if (!res.ok) return;
        const data = await res.json();
        const newCount = data.count;
        const newMod   = data.maxModified ?? '';

        // 1ª chamada: só guarda o baseline
        if (!lastKnownMod && lastKnownCount === initialCount) {
          lastKnownMod = newMod;
          lastKnownCount = newCount;
          return;
        }

        if (newCount !== lastKnownCount || newMod !== lastKnownMod) {
          // Mudou no servidor — salva scroll e recarrega
          sessionStorage.setItem('dia-scroll-y', String(window.scrollY));
          location.reload();
        }
      } catch { /* silencioso */ }
    }

    setInterval(poll, 60_000);
  })();
</script>
