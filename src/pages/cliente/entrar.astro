---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getCustomerSession } from '../../lib/customerSession.js';

// Se já está logado, vai direto pra listagem
const session = await getCustomerSession(Astro.request);
if (session) return Astro.redirect('/cliente');
---

<Layout
  title="Acessar meus agendamentos · Barbearia Bayron"
  description="Veja seus agendamentos na Barbearia Bayron usando seu telefone."
>
  <div class="min-h-screen bg-dark flex flex-col">

    <!-- Header -->
    <div class="border-b border-white/5 px-4 py-4">
      <div class="max-w-lg mx-auto flex items-center justify-between">
        <a href="/" class="text-neutral-400 hover:text-neutral-200 text-sm flex items-center gap-1.5 transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
          Início
        </a>
        <span class="text-neutral-400 text-sm font-medium">Barbearia Bayron</span>
      </div>
    </div>

    <main class="max-w-lg w-full mx-auto px-4 py-10 flex-1">

      <div class="text-center mb-8">
        <h1 class="font-serif text-2xl font-medium text-neutral-50">Meus agendamentos</h1>
        <p class="text-neutral-500 text-sm mt-2">
          Digite seu telefone para ver, cancelar ou reagendar.
        </p>
      </div>

      <form id="login-form" class="bg-dark-card border border-white/5 rounded-md p-6 space-y-4" novalidate>
        <div>
          <label for="phone" class="block text-xs text-neutral-500 uppercase tracking-widest mb-2">
            Telefone
          </label>
          <input
            id="phone"
            type="tel"
            inputmode="numeric"
            autocomplete="tel"
            placeholder="(84) 99999-9999"
            maxlength="16"
            required
            class="w-full bg-dark-surface border border-white/10 rounded px-4 py-3 text-base text-neutral-100 placeholder-neutral-600 focus:outline-none focus:border-teal/50 tabular-nums"
          />
        </div>

        <div>
          <label for="birthdate" class="block text-xs text-neutral-500 uppercase tracking-widest mb-2">
            Data de nascimento
          </label>
          <input
            id="birthdate"
            type="text"
            inputmode="numeric"
            autocomplete="bday"
            placeholder="dd/mm/aaaa"
            maxlength="10"
            required
            class="w-full bg-dark-surface border border-white/10 rounded px-4 py-3 text-base text-neutral-100 placeholder-neutral-600 focus:outline-none focus:border-teal/50 tabular-nums"
          />
        </div>

        <div id="error" class="hidden text-red-400 text-xs text-center py-1 leading-relaxed"></div>

        <button
          id="submit"
          type="submit"
          class="w-full bg-teal hover:bg-teal-hover text-white font-bold tracking-widest uppercase px-6 py-3.5 rounded-md transition-colors duration-300 text-sm disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Entrar
        </button>
      </form>

      <div class="my-6 flex items-center gap-3">
        <div class="flex-1 h-px bg-white/5"></div>
        <span class="text-xs text-neutral-600 uppercase tracking-widest">ou</span>
        <div class="flex-1 h-px bg-white/5"></div>
      </div>

      <a
        href="/agendar"
        class="block w-full border border-white/10 hover:border-teal/30 text-neutral-300 hover:text-teal-light text-center font-medium tracking-widest uppercase px-6 py-3.5 rounded-md transition-colors duration-300 text-sm"
      >
        Agendar
      </a>

      <p class="text-xs text-neutral-600 text-center mt-4 leading-relaxed">
        Primeira vez? Toque em <span class="text-neutral-400">Agendar</span> para escolher serviço, barbeiro e horário.
      </p>

    </main>
  </div>
</Layout>

<script>
  const form     = document.getElementById('login-form') as HTMLFormElement | null;
  const input    = document.getElementById('phone')      as HTMLInputElement | null;
  const bdInput  = document.getElementById('birthdate')  as HTMLInputElement | null;
  const errorEl  = document.getElementById('error');
  const submitEl = document.getElementById('submit')     as HTMLButtonElement | null;

  if (!form || !input || !bdInput || !errorEl || !submitEl) {
    throw new Error('Elementos do formulário não encontrados');
  }

  // Máscara dd/mm/aaaa
  function maskDate(raw: string): string {
    const d = raw.replace(/\D/g, '').slice(0, 8);
    if (d.length === 0) return '';
    if (d.length <= 2) return d;
    if (d.length <= 4) return `${d.slice(0, 2)}/${d.slice(2)}`;
    return `${d.slice(0, 2)}/${d.slice(2, 4)}/${d.slice(4)}`;
  }
  bdInput.addEventListener('input', () => {
    bdInput.value = maskDate(bdInput.value);
    errorEl.classList.add('hidden');
  });

  // Converte dd/mm/aaaa pra YYYY-MM-DD; retorna null se inválido ou fora da faixa (5–100 anos).
  function parseBirthdate(raw: string): string | null {
    const m = raw.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
    if (!m) return null;
    const dd = parseInt(m[1], 10);
    const mm = parseInt(m[2], 10);
    const yyyy = parseInt(m[3], 10);
    if (mm < 1 || mm > 12) return null;
    const dt = new Date(yyyy, mm - 1, dd);
    if (dt.getFullYear() !== yyyy || dt.getMonth() !== mm - 1 || dt.getDate() !== dd) return null;
    const now = new Date();
    const min = new Date(now.getFullYear() - 100, now.getMonth(), now.getDate());
    const max = new Date(now.getFullYear() - 5,   now.getMonth(), now.getDate());
    if (dt < min || dt > max) return null;
    const pad = (n: number) => String(n).padStart(2, '0');
    return `${yyyy}-${pad(mm)}-${pad(dd)}`;
  }

  // Máscara progressiva: (XX) XXXXX-XXXX ou (XX) XXXX-XXXX
  function maskPhone(raw: string): string {
    const d = raw.replace(/\D/g, '').slice(0, 11);
    if (d.length === 0) return '';
    if (d.length <= 2)  return `(${d}`;
    if (d.length <= 6)  return `(${d.slice(0, 2)}) ${d.slice(2)}`;
    if (d.length <= 10) return `(${d.slice(0, 2)}) ${d.slice(2, 6)}-${d.slice(6)}`;
    return `(${d.slice(0, 2)}) ${d.slice(2, 7)}-${d.slice(7)}`;
  }

  input.addEventListener('input', () => {
    const before = input.value;
    const masked = maskPhone(before);
    input.value = masked;
    errorEl.classList.add('hidden');
  });

  function showError(msg: string) {
    if (!errorEl) return;
    errorEl.textContent = msg;
    errorEl.classList.remove('hidden');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.classList.add('hidden');

    const phone     = input.value.replace(/\D/g, '');
    const birthdate = parseBirthdate(bdInput.value);
    if (phone.length < 10) {
      showError('Digite um telefone válido com DDD.');
      return;
    }
    if (!birthdate) {
      showError('Data de nascimento inválida. Use o formato dd/mm/aaaa.');
      return;
    }

    submitEl.disabled    = true;
    submitEl.textContent = 'Entrando...';

    try {
      const res = await fetch('/api/customer/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone, birthdate }),
      });

      if (res.ok) {
        window.location.href = '/cliente';
        return;
      }

      const data = await res.json().catch(() => ({}));
      showError(data.error ?? 'Erro ao entrar.');
    } catch {
      showError('Erro de conexão. Tente novamente.');
    } finally {
      submitEl.disabled    = false;
      submitEl.textContent = 'Entrar';
    }
  });

  input.focus();
</script>
