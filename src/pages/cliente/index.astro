---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getCustomerSession } from '../../lib/customerSession.js';
import { sqlite } from '../../db/index.js';
import { formatInTimeZone } from 'date-fns-tz';

const TZ = 'America/Fortaleza';

const session = await getCustomerSession(Astro.request);
if (!session) return Astro.redirect('/cliente/entrar');

const stmtList = sqlite.prepare(`
  SELECT
    a.id              AS id,
    a.status          AS status,
    a.starts_at       AS starts_at,
    a.ends_at         AS ends_at,
    a.duration_minutes AS duration_minutes,
    a.price_cents     AS price_cents,
    a.customer_name   AS customer_name,
    a.customer_phone  AS customer_phone,
    a.manage_token    AS manage_token,
    a.cancelled_at    AS cancelled_at,
    a.cancelled_by    AS cancelled_by,
    b.name            AS barber_name,
    s.name            AS service_name
  FROM appointments a
  INNER JOIN barbers  b ON b.id = a.barber_id
  INNER JOIN services s ON s.id = a.service_id
  WHERE substr(
    REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(
      a.customer_phone, ' ', ''), '(', ''), ')', ''), '-', ''), '+', ''), '.', ''),
    -11
  ) = ?
  AND a.customer_birthdate = ?
  ORDER BY a.starts_at DESC
`);

interface ApptRow {
  id: number;
  status: string;
  starts_at: string;
  ends_at: string;
  duration_minutes: number;
  price_cents: number;
  customer_name: string;
  customer_phone: string;
  manage_token: string;
  cancelled_at: string | null;
  cancelled_by: string | null;
  barber_name: string;
  service_name: string;
}

const rows = stmtList.all(session.phone, session.birthdate) as ApptRow[];

// Se a sessão é válida mas não tem mais agendamentos (todos deletados manualmente, por ex),
// devolve pra entrar.
if (rows.length === 0) return Astro.redirect('/cliente/entrar');

const nowIso = new Date().toISOString();

interface Card {
  id: number;
  status: string;
  isUpcoming: boolean;
  manageToken: string;
  customerName: string;
  serviceName: string;
  barberName: string;
  dateLabel: string;
  timeLabel: string;
  durationMinutes: number;
  priceLabel: string;
}

const cards: Card[] = rows.map(r => ({
  id:              r.id,
  status:          r.status,
  isUpcoming:      r.status === 'confirmed' && r.ends_at > nowIso,
  manageToken:     r.manage_token,
  customerName:    r.customer_name,
  serviceName:     r.service_name,
  barberName:      r.barber_name,
  dateLabel:       formatInTimeZone(new Date(r.starts_at), TZ, "dd 'de' MMM '·' EEE"),
  timeLabel:       formatInTimeZone(new Date(r.starts_at), TZ, 'HH:mm'),
  durationMinutes: r.duration_minutes,
  priceLabel:      `R$ ${(r.price_cents / 100).toFixed(0)}`,
}));

const upcoming = cards.filter(c => c.isUpcoming);
const past     = cards.filter(c => !c.isUpcoming);

// Pega o nome do primeiro registro pra cumprimentar
const customerName = rows[0].customer_name;
const firstName    = customerName.split(' ')[0];

// Mascara telefone pra exibir
function maskPhone(digits: string): string {
  if (digits.length === 11) return `(${digits.slice(0,2)}) ${digits.slice(2,7)}-${digits.slice(7)}`;
  if (digits.length === 10) return `(${digits.slice(0,2)}) ${digits.slice(2,6)}-${digits.slice(6)}`;
  return digits;
}
const phoneLabel = maskPhone(session.phone);

const STATUS_BADGE: Record<string, { text: string; cls: string; borderCls: string }> = {
  confirmed: { text: 'Confirmado',  cls: 'text-teal-light',   borderCls: 'border-teal/15' },
  cancelled: { text: 'Cancelado',   cls: 'text-red-400',      borderCls: 'border-red-500/10' },
  completed: { text: 'Concluído',   cls: 'text-neutral-400',  borderCls: 'border-white/5' },
  no_show:   { text: 'Não compareceu', cls: 'text-amber-400', borderCls: 'border-amber-500/15' },
};
---

<Layout
  title="Meus agendamentos · Barbearia Bayron"
  description="Veja seus agendamentos na Barbearia Bayron."
>
  <div class="min-h-screen bg-dark">

    <!-- Header -->
    <div class="border-b border-white/5 px-4 py-4">
      <div class="max-w-lg mx-auto flex items-center justify-between">
        <span class="text-neutral-400 text-sm font-medium">Barbearia Bayron</span>
        <button id="logout-btn" class="text-xs text-neutral-500 hover:text-red-400 transition-colors border border-white/10 hover:border-red-500/30 px-3 py-1 rounded">
          Sair
        </button>
      </div>
    </div>

    <main class="max-w-lg mx-auto px-4 py-8">

      <div class="mb-8">
        <h1 class="font-serif text-2xl font-medium text-neutral-50">Olá, {firstName}</h1>
        <p class="text-neutral-500 text-sm mt-1 tabular-nums">{phoneLabel}</p>
      </div>

      {upcoming.length > 0 && (
        <section class="mb-8">
          <p class="text-xs text-neutral-500 uppercase tracking-widest mb-3">
            Próximos {upcoming.length > 1 && `(${upcoming.length})`}
          </p>
          <div class="space-y-2">
            {upcoming.map(c => {
              const badge = STATUS_BADGE[c.status] ?? STATUS_BADGE.confirmed;
              return (
                <a
                  href={`/a/${c.manageToken}`}
                  class:list={['block bg-dark-card border rounded-md p-4 hover:border-teal/30 transition-colors group', badge.borderCls]}
                >
                  <div class="flex items-start justify-between gap-4">
                    <div class="min-w-0">
                      <p class="text-neutral-100 font-medium">{c.serviceName}</p>
                      <p class="text-neutral-400 text-sm mt-0.5">{c.barberName}</p>
                      <p class="text-neutral-500 text-xs mt-2 tabular-nums">{c.dateLabel}</p>
                    </div>
                    <div class="text-right shrink-0">
                      <p class="text-teal-light font-bold text-xl tabular-nums leading-none">{c.timeLabel}</p>
                      <p class="text-neutral-500 text-xs mt-1">{c.durationMinutes} min</p>
                      <p class="text-neutral-300 text-sm mt-1">{c.priceLabel}</p>
                    </div>
                  </div>
                  <div class="mt-3 flex items-center justify-between">
                    <span class={`text-xs ${badge.cls}`}>● {badge.text}</span>
                    <span class="text-xs text-neutral-500 group-hover:text-teal-light transition-colors">
                      Detalhes →
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )}

      {past.length > 0 && (
        <section class="mb-8">
          <p class="text-xs text-neutral-500 uppercase tracking-widest mb-3">
            Histórico
          </p>
          <div class="space-y-2">
            {past.map(c => {
              const badge = STATUS_BADGE[c.status] ?? STATUS_BADGE.completed;
              return (
                <a
                  href={`/a/${c.manageToken}`}
                  class:list={['block bg-dark-card border rounded-md p-4 hover:border-white/15 transition-colors group', badge.borderCls]}
                >
                  <div class="flex items-start justify-between gap-4">
                    <div class="min-w-0">
                      <p class="text-neutral-300 font-medium">{c.serviceName}</p>
                      <p class="text-neutral-500 text-sm mt-0.5">{c.barberName}</p>
                      <p class="text-neutral-600 text-xs mt-2 tabular-nums">{c.dateLabel}</p>
                    </div>
                    <div class="text-right shrink-0">
                      <p class="text-neutral-400 font-medium text-base tabular-nums leading-none">{c.timeLabel}</p>
                      <p class="text-neutral-600 text-xs mt-1">{c.priceLabel}</p>
                    </div>
                  </div>
                  <div class="mt-2 flex items-center justify-between">
                    <span class={`text-xs ${badge.cls}`}>{badge.text}</span>
                    <span class="text-xs text-neutral-600 group-hover:text-neutral-400 transition-colors">
                      Ver →
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )}

      <a
        href="/agendar"
        class="block w-full bg-teal hover:bg-teal-hover text-white text-center font-bold tracking-widest uppercase px-6 py-4 rounded-md transition-colors duration-300 text-sm"
      >
        Marcar novo horário
      </a>

    </main>
  </div>
</Layout>

<script>
  document.getElementById('logout-btn')?.addEventListener('click', async () => {
    try {
      await fetch('/api/customer/logout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
      });
    } catch { /* segue de qualquer jeito */ }
    window.location.href = '/';
  });
</script>
