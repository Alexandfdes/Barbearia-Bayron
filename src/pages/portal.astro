---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Portal · Barbearia Bayron"
  description="Acesse a área de cliente ou de funcionário da Barbearia Bayron."
>
  <div class="min-h-screen bg-dark flex flex-col">

    <!-- Top bar -->
    <div class="border-b border-white/5 px-4 py-4">
      <div class="max-w-5xl mx-auto flex items-center justify-between">
        <a href="/" class="text-neutral-400 hover:text-neutral-200 text-sm flex items-center gap-1.5 transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
          Início
        </a>
        <span class="text-neutral-400 text-sm font-medium">Barbearia Bayron</span>
      </div>
    </div>

    <main class="max-w-5xl w-full mx-auto px-4 sm:px-8 py-20 sm:py-28 flex-1 flex flex-col justify-center">

      <!-- Heading -->
      <div class="text-center mb-12 sm:mb-14">
        <h1 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
          Portal Bayron
        </h1>
        <p class="text-neutral-400 text-sm sm:text-base mt-3">
          Selecione seu perfil de acesso
        </p>
      </div>

      <!-- Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6">

        <!-- Cliente -->
        <a
          href="/cliente/entrar"
          class="relative overflow-hidden bg-dark-card border border-white/5 hover:border-teal/40 rounded-2xl p-7 sm:p-8 transition-all duration-300 group hover:-translate-y-0.5 hover:shadow-2xl hover:shadow-teal/10"
        >
          <!-- Ícone grande decorativo no fundo -->
          <svg
            class="absolute right-5 bottom-5 w-28 h-28 sm:w-32 sm:h-32 text-white/[0.04] group-hover:text-white/[0.06] transition-colors duration-300 pointer-events-none"
            fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>

          <!-- Ícone pequeno colorido no topo -->
          <div class="relative w-12 h-12 rounded-xl bg-teal/15 border border-teal/30 flex items-center justify-center mb-7">
            <svg class="w-6 h-6 text-teal-light" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-5.13a4 4 0 11-8 0 4 4 0 018 0zm6 0a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>

          <!-- Conteúdo -->
          <div class="relative">
            <h2 class="text-xl sm:text-2xl font-bold text-white">
              Área do Cliente
            </h2>
            <p class="text-neutral-400 text-sm mt-2 leading-relaxed max-w-[85%]">
              Veja, cancele ou reagende seus horários na barbearia.
            </p>
          </div>
        </a>

        <!-- Equipe / Admin -->
        <a
          href="/admin/login"
          class="relative overflow-hidden bg-dark-card border border-white/5 hover:border-teal/40 rounded-2xl p-7 sm:p-8 transition-all duration-300 group hover:-translate-y-0.5 hover:shadow-2xl hover:shadow-teal/10"
        >
          <!-- Ícone grande decorativo no fundo -->
          <svg
            class="absolute right-5 bottom-5 w-28 h-28 sm:w-32 sm:h-32 text-white/[0.04] group-hover:text-white/[0.06] transition-colors duration-300 pointer-events-none"
            fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2"
          >
            <!-- Tesoura de barbeiro -->
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 5.758a3 3 0 10-4.243 4.243 3 3 0 004.243-4.243zm0-5.758a3 3 0 10-4.243-4.243 3 3 0 004.243 4.243z"/>
          </svg>

          <!-- Ícone pequeno -->
          <div class="relative w-12 h-12 rounded-xl bg-teal/10 border border-teal/25 flex items-center justify-center mb-7">
            <svg class="w-6 h-6 text-teal-light/90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 5.758a3 3 0 10-4.243 4.243 3 3 0 004.243-4.243zm0-5.758a3 3 0 10-4.243-4.243 3 3 0 004.243 4.243z"/>
            </svg>
          </div>

          <!-- Conteúdo -->
          <div class="relative">
            <h2 class="text-xl sm:text-2xl font-bold text-white">
              Equipe Bayron
            </h2>
            <p class="text-neutral-400 text-sm mt-2 leading-relaxed max-w-[85%]">
              Gestão da agenda, serviços e bloqueios. Acesso restrito.
            </p>
          </div>
        </a>

      </div>

      <!-- Rodapé -->
      <p class="text-xs text-neutral-500 text-center mt-12 leading-relaxed">
        Primeira vez na barbearia?
        <a href="/agendar" class="text-neutral-300 underline hover:text-teal-light transition-colors ml-1">
          Marcar horário
        </a>
      </p>

    </main>
  </div>
</Layout>
