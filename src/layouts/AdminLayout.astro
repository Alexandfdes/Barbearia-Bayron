---
import '../styles/global.css';

interface Props {
  title?:     string;
  barberName: string;
  role:       'admin' | 'barber';
}
const { title = 'Admin', barberName, role } = Astro.props;
const path = Astro.url.pathname;

// Determina dinamicamente para onde o botão "Voltar" deve apontar de forma inteligente e universal:
// - Se estiver na tela principal do Admin (/admin), o botão de voltar leva ao Portal (/portal).
// - Se estiver em qualquer outra subpágina (ex: buscar, serviços, agenda do dia), leva de volta à tela inicial do Admin (/admin).
const normalizedPath = path.endsWith('/') && path.length > 1 ? path.slice(0, -1) : path;
const backUrl = normalizedPath === '/admin' ? '/portal' : '/admin';
---
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — Bayron Admin</title>
  </head>
  <body class="bg-dark text-neutral-200 min-h-screen">

    <!-- Top header -->
    <header class="border-b border-white/5 px-4 py-3 bg-dark">
      <div class="max-w-3xl mx-auto flex items-center justify-between">
        <div class="flex items-center gap-3">
          <a href={backUrl} class="text-xs text-neutral-400 hover:text-neutral-200 transition-colors flex items-center gap-1.5 font-medium">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
            Voltar
          </a>
          <div class="w-px h-3.5 bg-white/10"></div>
          <div class="flex items-center gap-2">
            <a href="/admin" class="text-sm font-medium text-neutral-200 hover:text-neutral-100 transition-colors">
              Bayron Admin
            </a>
            {role === 'admin' && (
              <span class="text-xs bg-teal/20 text-teal-light border border-teal/30 px-2 py-0.5 rounded-full">
                Admin
              </span>
            )}
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-xs text-neutral-500 hidden sm:block">{barberName}</span>
          <button id="__logout" class="text-xs text-neutral-500 hover:text-red-400 transition-colors border border-white/10 hover:border-red-500/30 px-3 py-1 rounded">
            Sair
          </button>
        </div>
      </div>
    </header>

    <!-- Navigation -->
    <nav class="border-b border-white/5 px-4 bg-dark sticky top-0 z-20">
      <div class="max-w-3xl mx-auto flex gap-1 overflow-x-auto">
        {[
          { href: '/admin',           label: 'Dia',       active: path.startsWith('/admin/dia') || path === '/admin' },
          { href: '/admin/buscar',    label: 'Buscar',    active: path === '/admin/buscar' },
          { href: '/admin/servicos',  label: 'Serviços',  active: path === '/admin/servicos' },
          { href: '/admin/horarios',  label: 'Horários',  active: path === '/admin/horarios' },
          { href: '/admin/relatorios', label: 'Relatórios', active: path === '/admin/relatorios' },
          ...(role === 'admin' ? [
            { href: '/admin/produtos',   label: 'Produtos',   active: path === '/admin/produtos' },
            { href: '/admin/combos',     label: 'Combos',     active: path === '/admin/combos' },
            { href: '/admin/barbeiros',  label: 'Barbeiros',  active: path === '/admin/barbeiros' },
          ] : []),
          { href: '/admin/bloqueios', label: 'Bloqueios', active: path === '/admin/bloqueios' },
        ].map(link => (
          <a href={link.href}
             class:list={[
               'text-xs font-medium px-3 py-3 border-b-2 transition-colors whitespace-nowrap',
               link.active
                 ? 'border-teal text-teal-light'
                 : 'border-transparent text-neutral-500 hover:text-neutral-300'
             ]}>
            {link.label}
          </a>
        ))}
      </div>
    </nav>

    <slot />

    <script>
      document.getElementById('__logout')?.addEventListener('click', async () => {
        await fetch('/api/auth/logout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });
        location.href = '/admin/login';
      });
    </script>
  </body>
</html>
