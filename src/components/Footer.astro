---
import { INSTAGRAM_URL } from '../config';
const currentYear = new Date().getFullYear();
---

<footer id="contato" class="border-t border-white/5 bg-zinc-900">
  <div class="max-w-6xl mx-auto px-4 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 rounded-sm bg-forest flex items-center justify-center">
            <svg class="w-5 h-5 text-ice" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-7 7m7-7l-7-7" />
            </svg>
          </div>
          <span class="text-lg font-bold tracking-tight">BAYRON</span>
        </div>
        <p class="text-sm text-zinc-400 leading-relaxed mb-4">
          Respeito e precisão em cada corte. A barbearia masculina premium de Mossoró.
        </p>
        <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-sm font-semibold text-bayron-green hover:text-ice transition-colors duration-200">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
          </svg>
          Siga no Instagram
        </a>
      </div>

      <!-- Address -->
      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider text-zinc-400 mb-4">Endereço</h4>
        <address class="not-italic text-sm text-ice leading-relaxed">
          <p>R. Jaen Menescal, 174</p>
          <p>Mossoró/RN</p>
        </address>
      </div>

      <!-- Hours -->
      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider text-zinc-400 mb-4">Horário</h4>
        <div class="text-sm text-ice space-y-1">
          <p>Seg — Sex: <span class="text-zinc-400">09:00 — 20:00</span></p>
          <p>Sábado: <span class="text-zinc-400">09:00 — 18:00</span></p>
          <p>Domingo: <span class="text-zinc-400">Fechado</span></p>
        </div>
      </div>
    </div>

    <div class="border-t border-white/5 mt-10 pt-6 text-center text-xs text-zinc-400">
      &copy; {currentYear} Barbearia Bayron. Todos os direitos reservados.
    </div>
  </div>
</footer>
