---
import { TOPSALAO_URL } from '../config';
import { Image } from 'astro:assets';
import logoSrc from '../assets/Logo-Bayron3.png';

interface Props {
  solid?: boolean;
}
const { solid = false } = Astro.props;
---

<header
  id="header"
  class:list={["fixed top-0 left-0 right-0 z-50 transition-colors duration-300", solid && "bg-black/95 backdrop-blur-md"]}
>
  <div class="w-full px-6 md:px-10 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 relative z-50">
      <Image
        src={logoSrc}
        alt="Barbearia Bayron"
        width={80}
        class="w-10 h-10 rounded-sm object-contain"
      />
      <span class="text-base font-semibold tracking-[0.2em] text-white uppercase">Bayron</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-8 text-sm text-neutral-400 uppercase tracking-wider font-medium">
      <a href="#servicos" class="hover:text-white transition-colors duration-300">Serviços</a>
      <a href="#combo" class="hover:text-white transition-colors duration-300">Combos</a>
      <a href="#produtos" class="hover:text-white transition-colors duration-300">Produtos</a>
      <a href="#depoimentos" class="hover:text-white transition-colors duration-300">Depoimentos</a>
      <a href="#faq" class="hover:text-white transition-colors duration-300">FAQ</a>
      <a href="#contato" class="hover:text-white transition-colors duration-300">Contato</a>
    </nav>

    <div class="flex items-center gap-4">
      <a
        href="/portal"
        id="header-cta"
        class="hidden sm:inline-flex border border-white/20 bg-transparent hover:bg-white/10 text-white text-xs font-medium px-6 py-2.5 rounded-sm transition-all duration-300 uppercase tracking-widest"
      >
        Portal
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden relative z-50 p-2 text-gray-light hover:text-white"
        aria-label="Toggle Menu"
      >
        <svg id="icon-menu" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Overlay -->
  <div
    id="mobile-menu"
    class="fixed inset-0 bg-dark z-40 flex flex-col items-center justify-center gap-8 opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
  >
    <nav class="flex flex-col items-center gap-8 text-xl font-medium text-neutral-400 uppercase tracking-wider">
      <a href="#servicos" class="mobile-link hover:text-white transition-colors">Serviços</a>
      <a href="#combo" class="mobile-link hover:text-white transition-colors">Combos</a>
      <a href="#produtos" class="mobile-link hover:text-white transition-colors">Produtos</a>
      <a href="#depoimentos" class="mobile-link hover:text-white transition-colors">Depoimentos</a>
      <a href="#faq" class="mobile-link hover:text-white transition-colors">FAQ</a>
      <a href="#contato" class="mobile-link hover:text-white transition-colors">Contato</a>
      <a
        href="/portal"
        class="bg-teal hover:bg-teal-hover text-white px-8 py-3 rounded-md mt-4 tracking-widest font-bold"
      >
        Portal
      </a>
    </nav>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const header = document.getElementById('header');
    const hero = document.getElementById('hero');

    if (header) {
      function updateHeaderBg() {
        const threshold = (hero?.offsetHeight ?? 400) - 80;
        const past = window.scrollY > threshold;
        header!.classList.toggle('bg-black/80', past);
        header!.classList.toggle('backdrop-blur-md', past);
      }
      window.addEventListener('scroll', updateHeaderBg, { passive: true });
      updateHeaderBg();
    }

    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconMenu = document.getElementById('icon-menu');
    const iconClose = document.getElementById('icon-close');
    const links = document.querySelectorAll('.mobile-link');
    const wa = document.getElementById('whatsapp-cta'); // botão flutuante do WhatsApp

    if (!btn || !menu || !iconMenu || !iconClose) return;

    function toggleMenu() {
      if (!menu || !iconMenu || !iconClose) return;
      const isClosed = menu.classList.contains('opacity-0');

      if (isClosed) {
        menu.classList.remove('opacity-0', 'pointer-events-none');
        iconMenu.classList.add('hidden');
        iconClose.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        wa?.classList.add('opacity-0', 'pointer-events-none'); // esconde o WhatsApp por baixo do menu
      } else {
        menu.classList.add('opacity-0', 'pointer-events-none');
        iconMenu.classList.remove('hidden');
        iconClose.classList.add('hidden');
        document.body.style.overflow = '';
        wa?.classList.remove('opacity-0', 'pointer-events-none');
      }
    }

    btn.addEventListener('click', toggleMenu);

    links.forEach(link => {
      link.addEventListener('click', toggleMenu);
    });
  });
</script>
