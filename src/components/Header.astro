---
import { TOPSALAO_URL } from '../config';
---

<header
  id="header"
  class="sticky top-0 z-50 bg-carbon/80 backdrop-blur-md border-b border-white/5"
>
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 relative z-50">
      <img
        src="/Logo-Bayron3.png"
        alt="Barbearia Bayron"
        class="w-10 h-10 rounded-sm object-contain"
      />
      <span class="text-lg font-bold tracking-tight">BAYRON</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-8 text-sm text-zinc-400">
      <a href="#servicos" class="hover:text-ice transition-colors duration-200">Serviços</a>
      <a href="#combo" class="hover:text-ice transition-colors duration-200">Combos</a>
      <a href="#produtos" class="hover:text-ice transition-colors duration-200">Produtos</a>
      <a href="#contato" class="hover:text-ice transition-colors duration-200">Contato</a>
    </nav>

    <div class="flex items-center gap-4">
      <a
        href={TOPSALAO_URL}
        target="_blank"
        rel="noopener"
        id="header-cta"
        class="hidden sm:inline-flex bg-bayron-green hover:bg-bayron-hover text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors duration-200"
      >
        Agendar
      </a>

      <!-- Mobile Menu Button -->
      <button 
        id="mobile-menu-btn" 
        class="md:hidden relative z-50 p-2 text-zinc-300 hover:text-white"
        aria-label="Toggle Menu"
      >
        <svg id="icon-menu" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Overlay -->
  <div 
    id="mobile-menu" 
    class="fixed inset-0 bg-carbon z-40 flex flex-col items-center justify-center gap-8 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
  >
    <nav class="flex flex-col items-center gap-8 text-xl font-bold text-zinc-300">
      <a href="#servicos" class="mobile-link hover:text-bayron-green transition-colors">Serviços</a>
      <a href="#combo" class="mobile-link hover:text-bayron-green transition-colors">Combos</a>
      <a href="#produtos" class="mobile-link hover:text-bayron-green transition-colors">Produtos</a>
      <a href="#contato" class="mobile-link hover:text-bayron-green transition-colors">Contato</a>
      <a
        href={TOPSALAO_URL}
        target="_blank"
        rel="noopener"
        class="bg-bayron-green text-white px-8 py-3 rounded-xl mt-4"
      >
        Agendar Horário
      </a>
    </nav>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconMenu = document.getElementById('icon-menu');
    const iconClose = document.getElementById('icon-close');
    const links = document.querySelectorAll('.mobile-link');

    if (!btn || !menu || !iconMenu || !iconClose) return;

    function toggleMenu() {
      if (!menu || !iconMenu || !iconClose) return;
      const isClosed = menu.classList.contains('opacity-0');
      
      if (isClosed) {
        menu.classList.remove('opacity-0', 'pointer-events-none');
        iconMenu.classList.add('hidden');
        iconClose.classList.remove('hidden');
        document.body.style.overflow = 'hidden'; // Prevents background scrolling
      } else {
        menu.classList.add('opacity-0', 'pointer-events-none');
        iconMenu.classList.remove('hidden');
        iconClose.classList.add('hidden');
        document.body.style.overflow = '';
      }
    }

    btn.addEventListener('click', toggleMenu);

    // Close menu when clicking a link
    links.forEach(link => {
      link.addEventListener('click', toggleMenu);
    });
  });
</script>
