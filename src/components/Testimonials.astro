---
import depoimentos from '../data/depoimentos.json';
import { SITE_URL } from '../config';

const GOOGLE_REVIEWS_URL = "https://www.google.com/maps/search/Barbearia+Bayron+Mossor%C3%B3+RN/";
const RATING = 5.0;
const REVIEW_COUNT = 227;

const ldJson = {
  "@context": "https://schema.org",
  "@type": "HairSalon",
  "@id": `${SITE_URL}/#business`,
  "name": "Barbearia Bayron",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": String(RATING),
    "reviewCount": String(REVIEW_COUNT)
  },
  "review": depoimentos.map(d => ({
    "@type": "Review",
    "author": { "@type": "Person", "name": d.name },
    "reviewRating": { "@type": "Rating", "ratingValue": String(d.rating) },
    "reviewBody": d.text
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(ldJson)} />

<section id="depoimentos" class="py-12 md:py-20 bg-dark-alt">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-16">
      <div class="w-10 h-px bg-teal mx-auto mb-6"></div>
      <span class="text-teal-light text-sm font-medium tracking-[0.25em] uppercase">Prova Social</span>
      <h2 class="font-serif text-3xl md:text-5xl font-medium mt-3 mb-4 text-neutral-50">O que dizem nossos clientes</h2>
      <p class="text-neutral-400 max-w-lg mx-auto">Avaliações reais de quem já passou pela cadeira.</p>
    </div>

    <!-- Nota média -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-6 mb-14">
      <div class="flex items-center gap-4 bg-dark-card border border-white/5 rounded-md px-7 py-5">
        <span class="text-5xl font-bold text-teal-light leading-none">{RATING.toFixed(1).replace('.', ',')}</span>
        <div>
          <div class="flex gap-1 mb-1.5" aria-label={`${RATING} de 5 estrelas`}>
            {Array.from({ length: 5 }).map(() => (
              <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <p class="text-xs text-neutral-400">Baseado em {REVIEW_COUNT} avaliações</p>
        </div>
      </div>
      <a
        href={GOOGLE_REVIEWS_URL}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-sm font-medium text-teal-light hover:text-white transition-colors duration-300 underline underline-offset-4 decoration-teal-light/40"
      >
        Ver avaliações no Google
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>

    <!-- Carrossel de avaliações (auto-scroll, igual ao das fotos) -->
    <div class="relative">
      <div id="reviews-carousel" data-count={depoimentos.length} class="flex gap-4 sm:gap-6 overflow-x-auto no-scrollbar pb-2">
      {[...depoimentos, ...depoimentos].map((d) => (
        <article class="shrink-0 w-[85%] min-[500px]:w-[46%] lg:w-[31.5%] bg-dark-card border border-white/5 hover:border-teal/20 rounded-md p-4 sm:p-5 md:p-6 flex flex-col gap-3 sm:gap-4 transition-colors duration-300">
          <div class="flex gap-1" aria-label={`${d.rating} de 5 estrelas`}>
            {Array.from({ length: d.rating }).map(() => (
              <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <blockquote class="text-[13px] sm:text-sm text-neutral-300 leading-relaxed flex-1">
            &ldquo;{d.text}&rdquo;
          </blockquote>
          <footer class="flex items-center gap-2.5 sm:gap-3 pt-1">
            <div
              class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-teal/20 flex items-center justify-center text-teal-light font-semibold text-xs sm:text-sm shrink-0"
              aria-hidden="true"
            >
              {d.initial}
            </div>
            <div>
              <cite class="text-xs sm:text-sm font-medium text-neutral-200 not-italic block">{d.name}</cite>
              <span class="text-[10px] sm:text-xs text-neutral-500">{d.date}</span>
            </div>
          </footer>
        </article>
      ))}
      </div>

      <!-- Setas (desktop) -->
      <button id="reviews-prev" type="button" aria-label="Avaliações anteriores"
        class="hidden md:flex absolute -left-3 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-black/60 hover:bg-black/80 backdrop-blur-sm border border-white/10 hover:border-white/20 items-center justify-center text-white transition-all duration-200 hover:scale-110">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      </button>
      <button id="reviews-next" type="button" aria-label="Próximas avaliações"
        class="hidden md:flex absolute -right-3 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-black/60 hover:bg-black/80 backdrop-blur-sm border border-white/10 hover:border-white/20 items-center justify-center text-white transition-all duration-200 hover:scale-110">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>

    <p class="md:hidden text-center text-[11px] text-neutral-600 mt-3">Deslize para ver mais →</p>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const carousel = document.getElementById("reviews-carousel");
    if (!carousel) return;

    const originalCount = parseInt(carousel.getAttribute("data-count") || "0", 10);
    let paused = false;          // hover / setas
    let touching = false;        // dedo na tela
    let userInteracted = false;  // entre touch e fim da inércia
    let isProgrammaticScroll = false;
    let scrollIdleTimer: number | undefined;
    let currentScroll = 0;
    const SCROLL_SPEED = 0.5;    // texto: mais devagar que o carrossel de fotos
    const SCROLL_IDLE_DELAY = 200;

    function gapPx() {
      const g = parseFloat(getComputedStyle(carousel!).columnGap || "16");
      return isFinite(g) ? g : 16;
    }
    function cardStep() {
      const card = carousel!.querySelector<HTMLElement>("article");
      return card ? card.offsetWidth + gapPx() : 320;
    }
    function isPaused() { return paused || touching || userInteracted; }

    carousel.addEventListener("scroll", () => {
      if (isProgrammaticScroll) return;
      currentScroll = carousel.scrollLeft;
      if (scrollIdleTimer) clearTimeout(scrollIdleTimer);
      scrollIdleTimer = window.setTimeout(() => {
        if (!touching) { userInteracted = false; currentScroll = carousel.scrollLeft; }
      }, SCROLL_IDLE_DELAY);
    }, { passive: true });

    function tick() {
      if (!isPaused()) {
        currentScroll += SCROLL_SPEED;
        const singleSet = cardStep() * originalCount; // largura de um conjunto
        if (singleSet > 0 && currentScroll >= singleSet) currentScroll -= singleSet;
        isProgrammaticScroll = true;
        carousel!.scrollLeft = currentScroll;
        requestAnimationFrame(() => { isProgrammaticScroll = false; });
      }
      requestAnimationFrame(tick);
    }

    // Pausa no hover (pra ler) e durante o toque
    carousel.addEventListener("mouseenter", () => { paused = true; });
    carousel.addEventListener("mouseleave", () => { paused = false; });
    carousel.addEventListener("touchstart", () => { touching = true; userInteracted = true; }, { passive: true });
    carousel.addEventListener("touchend", () => {
      touching = false;
      // Mesmo num toque sem arrastar (tap), libera a pausa depois de um tempo —
      // senão a flag fica presa e o carrossel congela no meio de um card.
      setTimeout(() => { userInteracted = false; currentScroll = carousel.scrollLeft; }, 2000);
    }, { passive: true });
    carousel.addEventListener("touchcancel", () => { touching = false; userInteracted = false; }, { passive: true });

    document.getElementById("reviews-prev")?.addEventListener("click", () => {
      paused = true;
      currentScroll = Math.max(0, currentScroll - cardStep());
      carousel.scrollLeft = currentScroll;
      setTimeout(() => { paused = false; }, 2000);
    });
    document.getElementById("reviews-next")?.addEventListener("click", () => {
      paused = true;
      currentScroll += cardStep();
      carousel.scrollLeft = currentScroll;
      setTimeout(() => { paused = false; }, 2000);
    });

    requestAnimationFrame(tick);
  });
</script>
