---
import { TOPSALAO_URL } from "../config";
import { Image } from "astro:assets";
import heroImg from "../assets/fotos-videos/foto-inicial5.png";
---

<section
  id="hero"
  class="relative min-h-[100svh] flex items-end lg:items-center overflow-hidden pt-24 pb-28 sm:pb-32 lg:py-24"
>
  <!-- Background image -->
  <div class="absolute inset-0 z-0">
    <Image
      src={heroImg}
      alt="Barbearia Bayron"
      class="w-full h-full object-cover object-[center_20%] lg:object-[70%_30%]"
      loading="eager"
      fetchpriority="high"
      widths={[640, 1280, 1920]}
      sizes="100vw"
    />
    <!-- Gradiente inferior: mais denso no mobile para cobrir a roupa -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/60 lg:via-black/40 to-black/10 lg:to-black/10"
    >
    </div>
    <!-- Gradiente lateral esquerdo (desktop) -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/30 to-transparent"
    >
    </div>
  </div>

  <!-- Content -->
  <div class="relative z-10 w-full px-6 sm:px-10 md:px-20 max-w-4xl flex flex-col items-center text-center lg:items-start lg:text-left">
    <h1
      class="font-serif text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-medium leading-tight text-white mb-2"
    >
      Estilo com
      <span class="italic text-teal-light">respeito.</span><br />
      Corte com
      <span class="italic text-teal-light">precisão.</span>
    </h1>

    <p
      class="font-sans text-sm md:text-base text-neutral-300 max-w-md mb-7 leading-relaxed"
    >
      Visagismo personalizado que valoriza o formato do seu rosto, seu estilo e
      sua identidade.
    </p>

    <a
      href={TOPSALAO_URL}
      id="hero-cta"
      class="inline-flex items-center gap-3 bg-[#0f766e] hover:bg-[#0d9488] text-white font-bold uppercase tracking-widest rounded-sm transition-colors duration-300 px-6 py-3 text-xs lg:px-10 lg:py-4 lg:text-sm"
    >
      Reservar Horário
      <svg
        class="w-4 h-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
      </svg>
    </a>
  </div>
</section>
