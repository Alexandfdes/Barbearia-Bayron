---
import { TOPSALAO_URL } from "../config";
---

<section
  id="hero"
  class="relative h-[100dvh] min-h-screen flex items-end overflow-hidden"
>
  <!-- Background image -->
  <div class="absolute inset-0 z-0">
    <img
      src="/fotos-videos/foto-inicial6.png"
      alt="Barbearia Bayron"
      class="w-full h-full object-cover object-[center_20%]"
    />
    <!-- Gradient: stronger on left side where text sits -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-black/10"
    >
    </div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/50 to-transparent">
    </div>
  </div>

  <!-- Content anchored to bottom-left, pushed further left -->
  <div class="relative z-10 w-full px-10 md:px-20 pb-20 md:pb-60 max-w-4xl">
    <h1
      class="font-serif text-3xl sm:text-4xl md:text-6xl font-medium leading-[1.12] text-white mb-5"
    >
      Estilo com
      <span class="italic text-teal-light">respeito.</span><br />
      Corte com
      <span class="italic text-teal-light">precisão.</span>
    </h1>

    <p
      class="font-sans text-base md:text-lg text-neutral-300 max-w-lg mb-9 leading-relaxed"
    >
      Visagismo personalizado que valoriza o formato do seu rosto, seu estilo e
      sua identidade.
    </p>

    <a
      href={TOPSALAO_URL}
      target="_blank"
      rel="noopener"
      id="hero-cta"
      class="inline-flex items-center gap-3 bg-[#0f766e] hover:bg-[#0d9488] text-white text-sm font-bold uppercase tracking-widest px-10 py-4 rounded-sm transition-colors duration-300"
    >
      Reservar Horário
      <svg
        class="w-4 h-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
      </svg>
    </a>
  </div>
</section>
