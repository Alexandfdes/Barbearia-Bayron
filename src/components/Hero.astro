---
import { TOPSALAO_URL } from "../config";
---

<section
  id="hero"
  class="relative min-h-[100svh] flex items-end lg:items-center overflow-hidden pt-24 pb-16 sm:pb-20 lg:py-24"
>
  <!-- Background image -->
  <div class="absolute inset-0 z-0">
    <img
      src="/fotos-videos/foto-inicial7.jpg"
      alt="Barbearia Bayron"
      class="w-full h-full object-cover object-[70%_30%]"
    />
    <!-- Gradient: stronger on left side where text sits -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-black/10"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/30 to-transparent"
    >
    </div>
  </div>

  <!-- Content -->
  <div class="relative z-10 w-full px-6 sm:px-10 md:px-20 max-w-4xl">
    <h1
      class="font-serif text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-medium leading-tight text-white mb-2"
    >
      Estilo com
      <span class="italic text-teal-light">respeito.</span><br />
      Corte com
      <span class="italic text-teal-light">precisão.</span>
    </h1>

    <p
      class="font-sans text-sm md:text-base text-neutral-300 max-w-md mb-7 leading-relaxed"
    >
      Visagismo personalizado que valoriza o formato do seu rosto, seu estilo e
      sua identidade.
    </p>

    <a
      href={TOPSALAO_URL}
      target="_blank"
      rel="noopener"
      id="hero-cta"
      class="inline-flex items-center gap-3 bg-[#0f766e] hover:bg-[#0d9488] text-white text-sm font-bold uppercase tracking-widest px-10 py-4 rounded-sm transition-colors duration-300"
    >
      Reservar Horário
      <svg
        class="w-4 h-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
      </svg>
    </a>
  </div>
</section>
