---
import { TOPSALAO_URL } from "../config";
import { Image } from "astro:assets";
import comboImg from "../assets/fotos-videos/carrosel7.jpg";
---

<section id="combo" class="py-12 md:py-20 relative">
  <div class="relative z-10 max-w-6xl mx-auto px-4">
    <div
      class="rounded-lg overflow-hidden border border-teal/20 bg-gradient-to-br from-neutral-900 via-neutral-950 to-neutral-900"
    >
      <div class="grid md:grid-cols-2">
        <!-- Right: Info -->
        <div class="p-8 md:p-14 flex flex-col justify-center md:order-2">
          <div class="flex flex-wrap items-center gap-4 mb-2">
            <span
              class="text-teal-light text-xs font-medium tracking-[0.25em] uppercase"
              >Promoção do Dia</span
            >
          </div>

          <div class="flex flex-wrap items-center gap-4 mb-6">
            <h2 class="font-serif text-3xl md:text-4xl font-medium text-white">
              Combo Boris
            </h2>
            <span
              class="bg-teal text-white text-xs font-bold px-2.5 py-1 rounded-sm uppercase tracking-wider"
            >
              10% OFF
            </span>
          </div>

          <p class="text-neutral-300 text-base mb-8 leading-relaxed">
            Feche Cabelo + Barba e leve qualquer produto da linha Boris com
            desconto no valor total.
          </p>

          <ul class="space-y-3 mb-10">
            {
              [
                "Degradê ou Social na régua",
                "Barba alinhada na navalha",
                "Produto Boris à sua escolha",
              ].map((item) => (
                <li class="flex items-center gap-3 text-neutral-200">
                  <svg
                    class="w-4 h-4 text-teal-light shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  {item}
                </li>
              ))
            }
          </ul>

          <a
            href={TOPSALAO_URL}
            target="_blank"
            rel="noopener"
            id="combo-boris-cta"
            class="inline-flex items-center justify-center gap-3 bg-[#0f766e] hover:bg-[#0d9488] text-white font-bold text-sm uppercase tracking-widest px-10 py-4 rounded-sm transition-colors duration-300 w-full sm:w-auto"
          >
            Agendar Combo
            <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>

        <!-- Left: Photo (hidden on mobile) -->
        <div class="hidden md:block relative md:min-h-full md:order-1">
          <Image
            src={comboImg}
            alt="Resultado do Combo Boris — Corte e Barba"
            class="w-full h-full object-cover object-[center_35%] md:object-center"
            loading="lazy"
            widths={[600, 800, 1200]}
            sizes="(max-width: 768px) 100vw, 50vw"
          />
          <div
            class="hidden md:block absolute inset-0 bg-gradient-to-l from-neutral-950/40 to-transparent"
          >
          </div>
          <div
            class="absolute top-4 right-4 bg-teal text-white text-xs font-bold px-3 py-1.5 rounded-sm uppercase tracking-widest shadow-lg"
          >
            Mais Vendido
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
