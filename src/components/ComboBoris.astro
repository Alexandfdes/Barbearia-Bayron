---
import { getWhatsAppUrl } from '../config';
const whatsappUrl = getWhatsAppUrl("🔥 PROMOÇÃO DE HOJE: Fechando Cabelo + Barba e levando qualquer produto da linha Boris, você ganha 10% de desconto no valor total.");
---

<section id="combo" class="py-20 md:py-28 relative bg-dark-alt">
  <div class="relative z-10 max-w-6xl mx-auto px-4">
    <div class="bg-dark-card border border-white/5 rounded-md p-8 md:p-14 relative overflow-hidden">

      <div class="relative grid md:grid-cols-2 gap-10 items-center">
        <!-- Info -->
        <div>
          <div class="w-10 h-px bg-teal mb-6"></div>
          <div class="flex flex-wrap items-center gap-4 mb-6">
            <h2 class="font-serif text-3xl md:text-4xl font-medium text-neutral-50">Combo Boris</h2>
            <span class="bg-teal text-white text-xs font-bold px-3 py-1 rounded-sm uppercase tracking-widest">
              10% OFF
            </span>
          </div>

          <p class="text-neutral-300 text-lg mb-8 leading-relaxed">
            Feche Cabelo + Barba e leve qualquer produto da linha Boris com 10% de desconto no valor total.
          </p>

          <ul class="space-y-4 mb-10">
            {["Degradê ou Social na régua", "Barba alinhada na navalha", "Produto Boris à sua escolha"].map((item) => (
              <li class="flex items-center gap-3 text-neutral-200">
                <svg class="w-4 h-4 text-teal-light shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                {item}
              </li>
            ))}
          </ul>

          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener"
            id="combo-boris-cta"
            class="inline-flex items-center gap-3 bg-teal hover:bg-teal-hover text-white font-bold text-sm uppercase tracking-widest px-10 py-4 rounded-md transition-colors duration-300"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Quero o Combo Boris
          </a>
        </div>

        <!-- Visual (desktop) -->
        <div class="hidden md:flex items-center justify-center">
          <div class="relative">
            <div class="w-64 h-64 rounded-full border border-white/5 flex items-center justify-center">
              <div class="w-48 h-48 rounded-full bg-dark-surface flex items-center justify-center border border-white/5">
                <div class="text-center">
                  <div class="text-5xl mb-3">✂️</div>
                  <div class="text-sm font-bold text-teal-light uppercase tracking-widest">Combo</div>
                  <div class="text-xs text-neutral-400 mt-1">Cabelo + Barba + Produto</div>
                </div>
              </div>
            </div>
            <div class="absolute -top-2 -right-2 bg-teal text-white text-xs font-bold px-3 py-1.5 rounded-sm uppercase tracking-widest">
              Mais Vendido
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
