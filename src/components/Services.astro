---
import { TOPSALAO_URL } from '../config';

const services = [
  { name: "Degradê", price: "R$ 45", desc: "Corte preciso com acabamento na régua" },
  { name: "Social", price: "R$ 40", desc: "Corte clássico com tesoura e máquina" },
  { name: "Barba", price: "R$ 30", desc: "Alinhamento e modelagem na navalha" },
];

const combos = [
  { name: "Degradê + Barba", price: "R$ 65", desc: "O clássico completo", highlight: true },
];
---

<section id="servicos" class="py-20 md:py-28">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-16">
      <span class="text-bayron-green text-sm font-semibold tracking-widest uppercase">Catálogo</span>
      <h2 class="text-3xl md:text-5xl font-black mt-2 mb-4">Nossos Serviços</h2>
      <p class="text-zinc-400 max-w-lg mx-auto">Cada serviço executado com técnica e atenção aos detalhes.</p>
    </div>

    <!-- Individual services grid -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-12">
      {services.map((s) => (
        <div class="group bg-zinc-900 border border-white/5 hover:border-forest-light/30 rounded-xl p-6 transition-colors duration-200">
          <div class="flex items-start justify-between mb-2">
            <h3 class="text-lg font-bold">{s.name}</h3>
            <span class="text-bayron-green font-bold text-lg">{s.price}</span>
          </div>
          <p class="text-sm text-zinc-400">{s.desc}</p>
        </div>
      ))}
    </div>

    <!-- Combo -->
    <div class="max-w-md mx-auto">
      {combos.map((c) => (
        <a
          href={TOPSALAO_URL}
          target="_blank"
          rel="noopener"
          class="group block bg-forest/10 border border-forest-light/40 hover:border-bayron-green/60 rounded-xl p-6 transition-all duration-200 text-center"
        >
          <span class="inline-block bg-bayron-green text-white text-[10px] font-black px-2.5 py-0.5 rounded-full mb-3 uppercase tracking-wider">
            Popular
          </span>
          <h4 class="text-xl font-bold mb-1">{c.name}</h4>
          <p class="text-sm text-zinc-400 mb-3">{c.desc}</p>
          <span class="text-3xl font-black text-bayron-green">{c.price}</span>
        </a>
      ))}
    </div>

    <div class="text-center mt-10">
      <a
        href={TOPSALAO_URL}
        target="_blank"
        rel="noopener"
        id="servicos-cta"
        class="inline-flex items-center gap-2 bg-bayron-green hover:bg-bayron-hover text-white font-bold px-8 py-4 rounded-xl transition-colors duration-200 shadow-lg shadow-bayron-green/20"
      >
        AGENDAR AGORA
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
