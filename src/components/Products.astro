---
import { getWhatsAppUrl } from '../config';

const products = [
  {
    name: "Óleo Mentolado Boris",
    price: "R$ 45",
    desc: "Garante brilho e proteção todos os dias. Nutre, hidrata e protege cada fio da sua barba.",
    img: "/products/oleo-mentolado6.jpeg",
    msg: "Olá! Quero saber mais sobre o Óleo Mentolado Boris."
  },
  {
    name: "Balm Classic Boris",
    price: "R$ 49",
    desc: "Fórmula rica em ativos hidratantes. Reduz oleosidade, acalma a pele e mantém a barba alinhada.",
    img: "/products/balm-classic4.jpeg",
    msg: "Olá! Quero saber mais sobre o Balm Classic Boris."
  },
  {
    name: "Tônico Boris",
    price: "R$ 89",
    desc: "Desenvolvido para falhas na barba e calvície. Estimula o crescimento e dá volume aos fios.",
    img: "/products/tonico4.jpeg",
    msg: "Olá! Quero saber mais sobre o Tônico Boris."
  },
];
---

<section id="produtos" class="py-20 md:py-28 relative">
  <div class="relative z-10 max-w-6xl mx-auto px-4">
    <div class="text-center mb-16">
      <div class="w-10 h-px bg-teal mx-auto mb-6"></div>
      <span class="text-teal-light text-sm font-medium tracking-[0.25em] uppercase">Linha Exclusiva</span>
      <h2 class="font-serif text-3xl md:text-5xl font-medium mt-3 mb-4 text-neutral-50">Produtos Boris</h2>
      <p class="text-neutral-400 max-w-lg mx-auto">Desenvolvidos para quem leva o cuidado pessoal a sério.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      {products.map((p) => {
        const url = getWhatsAppUrl(p.msg);
        return (
          <div class="bg-dark-card border border-white/5 hover:border-teal/20 rounded-md overflow-hidden flex flex-col transition-colors duration-300 group">
            <!-- Product image -->
            <div class="relative aspect-square overflow-hidden">
              <img
                src={p.img}
                alt={p.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                loading="lazy"
              />
            </div>
            <!-- Info -->
            <div class="p-6 flex flex-col flex-1">
              <h3 class="font-serif text-lg font-medium text-neutral-50 mb-2">{p.name}</h3>
              <p class="text-sm text-neutral-400 mb-5 flex-1">{p.desc}</p>
              <div class="flex items-center justify-between">
                <span class="text-teal-light font-semibold text-xl">{p.price}</span>
                <a
                  href={url}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center gap-2 text-sm font-medium text-neutral-300 hover:text-white border border-white/10 hover:border-teal/30 px-4 py-2.5 rounded-sm transition-all duration-300 uppercase tracking-wider"
                >
                  Saiba Mais
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
